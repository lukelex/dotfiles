{
  "$schema": "https://opencode.ai/config.json",

  "skills": ["~/dotfiles/.opencode/skills"],

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://ollama.homelab/v1",
      },
      "models": {
        "qwen3.5:4b-q8_0": {
          "name": "Qwen 3.5 4B Fast",
        },
        "qwen3.5:35b-a3b-q4_K_M": {
          "name": "Qwen 3.5 35B Deep",
        },
      },
    },
  },
  "providers": {
    "github-copilot": {
      "models": {
        "claude-fable-5": { "disabled": true },
        "claude-fable-5.1": { "disabled": true },
        "claude-haiku-4.5": { "disabled": true },
        "claude-haiku-5.5": { "disabled": true },
        "claude-opus-4.8": { "disabled": true },
        "claude-opus-4.8-fast": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-opus-5.5": { "disabled": true },
        "claude-sonnet-4.6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true },
        "claude-sonnet-5.5": { "disabled": true },
        "gemini-3.8-flash": { "disabled": true },
        "gemini-4-argon": { "disabled": true },
        "gpt-5.3-codex": { "disabled": true },
        "gpt-5.4-nano": { "disabled": true },
        "gpt-5.6-luna": { "disabled": true },
        "gpt-5.6-sol": { "disabled": true },
        "gpt-5.6-terra": { "disabled": true },
        "gpt-6-astra": { "disabled": true },
        "gpt-6-luna": { "disabled": true },
        "gpt-6-sol": { "disabled": true },
        "gpt-6.1-sol": { "disabled": true },
        "grok-4.5": { "disabled": true },
        "grok-4.6": { "disabled": true },
        "grok-4.7": { "disabled": true },
        "kimi-k3": { "disabled": true },
        "mai-code-1.1-flash": { "disabled": true },
      },
    },
  },
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
      },
      "railway": {
        "type": "remote",
        "url": "https://mcp.railway.com"
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.datadoghq.eu/v1/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}",
        },
      },
    },
  },
}
