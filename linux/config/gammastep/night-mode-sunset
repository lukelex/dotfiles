#!/usr/bin/bash

set -eu

source "$HOME/dotfiles/linux/variables.env"

cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/weather/current.json"

night_is_active() {
  local sunrise sunset now

  [[ -r $cache_file ]] || return 1
  sunrise=$(jq -er '.sys.sunrise | numbers | floor' "$cache_file" 2>/dev/null) || return 1
  sunset=$(jq -er '.sys.sunset | numbers | floor' "$cache_file" 2>/dev/null) || return 1
  now=$(date +%s)

  [[ $now -ge $sunset || $now -lt $sunrise ]]
}

session_is_locked() {
  local session_id user

  user=${USER:-$(id -un)}
  session_id=${XDG_SESSION_ID:-}
  if [[ -z $session_id ]]; then
    session_id=$(loginctl show-user "$user" -p Display --value 2>/dev/null || true)
  fi

  if [[ -n $session_id ]] && [[ "$(loginctl show-session "$session_id" -p LockedHint --value 2>/dev/null || true)" == yes ]]; then
    return 0
  fi

  pidof hyprlock >/dev/null 2>&1 || pidof i3lock >/dev/null 2>&1
}

night_is_active || exit 0
[[ "$("$DOTFILES/linux/config/quickshell/scripts/nightmode" get 2>/dev/null || true)" != true ]] || exit 0

# Keep the offer until the session is unlocked, unless daylight arrives first.
while session_is_locked; do
  night_is_active || exit 0
  sleep 5
done

night_is_active || exit 0
[[ "$("$DOTFILES/linux/config/quickshell/scripts/nightmode" get 2>/dev/null || true)" != true ]] || exit 0

action=$(notify-send -a System \
  -i "$LUCIDE_PATH/moon-star.svg" \
  -h string:wired-tag:night-mode \
  -t 3300000 \
  -A turn-on='Turn on' \
  'Night mode' 'It is nighttime. Turn on night mode?' || true)

if [[ $action == turn-on ]]; then
  "$DOTFILES/linux/config/quickshell/scripts/nightmode" on
fi
