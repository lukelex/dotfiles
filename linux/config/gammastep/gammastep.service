[Unit]
Description=Screen temperature adjustment (gammastep)
Documentation=https://gitlab.com/chadmed/gammastep
After=graphical.target

[Install]
WantedBy=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/dotfiles/linux/config/system-settings/settings.py run-night-light
Restart=on-failure
RestartSec=5
EnvironmentFile=%h/dotfiles/linux/variables.env
