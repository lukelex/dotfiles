#!/usr/bin/bash

set -eu

source "$HOME/dotfiles/linux/variables.env"

CHARGING=$(printf "\ue054")
CRITICAL=$(printf "\ue3ac")
LOW=$(printf "\ue056")
HALF=$(printf "\ue057")
THREE_QUARTERS=$(printf "\ue057")
FULL=$(printf "\ue055")
LOW_BATTERY_THRESHOLD=15
LOW_BATTERY_NOTIFICATION_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/battery-low-notified"
CRITICAL_BATTERY_THRESHOLDS=(14 10 5)
BATTERY_NOTIFICATION_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/battery-critical-notified"

if [[ ${1:-} != power && ${1:-} != lower-profile ]]; then
  device=$(upower -e | grep 'BAT' | head -n 1)
  stats=$(upower -i "$device" | grep -E "state|to full|percentage|time to empty")
fi

get_percentage() {
  echo "$stats" | grep percentage | awk '{print $2}' | sed 's/%//'
}

get_state() {
  echo "$stats" | grep state | awk '{print $2}'
}

is_charging() {
  [[ "$(get_state)" == charging ]]
}

icon() {
  value=$(get_percentage)

  if is_charging; then
    echo $CHARGING
  elif [[ 1 -eq $(echo "$value < 15" | bc -l) ]]; then
    echo "%{F#FF0000}$CRITICAL%{F-}"
  elif [[ 1 -eq $(echo "$value < 40" | bc -l) ]]; then
    echo $LOW
  elif [[ 1 -eq $(echo "$value < 65" | bc -l) ]]; then
    echo $HALF
  elif [[ 1 -eq $(echo "$value < 90" | bc -l) ]]; then
    echo $THREE_QUARTERS
  else
    echo $FULL
  fi
}

notification_icon() {
  local value

  value=$(get_percentage)

  if is_charging; then
    echo "$LUCIDE_PATH/battery-charging.svg"
  elif [[ $value -lt 15 ]]; then
    echo "$LUCIDE_PATH/battery-warning.svg"
  elif [[ $value -lt 40 ]]; then
    echo "$LUCIDE_PATH/battery-low.svg"
  elif [[ $value -lt 65 ]]; then
    echo "$LUCIDE_PATH/battery-medium.svg"
  elif [[ $value -lt 90 ]]; then
    echo "$LUCIDE_PATH/battery-high.svg"
  else
    echo "$LUCIDE_PATH/battery-full.svg"
  fi
}

get() {
  state=$(echo "$stats" | grep state | awk '{print $2}')
  charge=$(echo "$stats" | grep percentage | awk '{print $2}')
  time=$(echo "$stats" | grep time | awk '{print $4" "$5}')

  echo "$state | $charge | $time"
}

shorten_time() {
  case "$1" in
    *hours)   echo "${1% hours} hr" ;;
    *minutes) echo "${1% minutes} min" ;;
    *seconds) echo "${1% seconds} sec" ;;
    *)        echo "$1 left" ;;
  esac
}

power() {
  local state=$1 charge=$2
  local icon

  case "$state" in
    plugged)
      local battery_state=${3:-charging}
      local summary="Power connected"
      local body="Battery is at $charge%"
      icon="$LUCIDE_PATH/battery.svg"
      if [[ $battery_state == fully-charged ]]; then
        icon="$LUCIDE_PATH/battery-full.svg"
        body="Battery already fully charged"
      elif [[ $battery_state == pending-charge ]]; then
        body="Charging is pending at $charge%"
      elif [[ $battery_state == charging ]]; then
        summary="Charging started"
        icon="$LUCIDE_PATH/battery-charging.svg"
        body="$charge% charged"
      fi
      notify-send -a System \
        -i "$icon" \
        -h string:wired-tag:battery-charging \
        -h boolean:suppress-sound:true \
        -h int:value:"$charge" \
        "$summary" "$body"
      ;;
    unplugged)
      if [[ $charge -lt 15 ]]; then
        icon="$LUCIDE_PATH/battery-warning.svg"
      elif [[ $charge -lt 40 ]]; then
        icon="$LUCIDE_PATH/battery-low.svg"
      elif [[ $charge -lt 65 ]]; then
        icon="$LUCIDE_PATH/battery-medium.svg"
      elif [[ $charge -lt 90 ]]; then
        icon="$LUCIDE_PATH/battery-high.svg"
      else
        icon="$LUCIDE_PATH/battery-full.svg"
      fi
      notify-send -a System \
        -i "$icon" \
        -h string:wired-tag:battery \
        -h boolean:suppress-sound:true \
        -h int:value:"$charge" \
        "Running on battery" "$charge% remaining"
      ;;
  esac
}

show_battery() {
  local charge
  local time
  local notification_icon

  charge=$(get_percentage)
  time=$(echo "$stats" | grep time | awk '{print $4" "$5}')
  notification_icon=$(notification_icon)

  if [[ -z $time ]]; then
    message="Full"
  else
    message=$(shorten_time "$time")
  fi

  notify-send -a System \
    -i "$notification_icon" \
    -h string:wired-tag:system \
    -h int:value:"$charge" \
    "$message"
}

warn() {
  local state
  local charge

  state=$(get_state)
  charge=$(get_percentage)

  if [[ $state != discharging ]]; then
    rm -f "$LOW_BATTERY_NOTIFICATION_FILE"
    rm -rf "$BATTERY_NOTIFICATION_DIR"
    return
  fi

  if [[ $charge -le $LOW_BATTERY_THRESHOLD && $charge -gt ${CRITICAL_BATTERY_THRESHOLDS[0]} ]]; then
    if [[ ! -e $LOW_BATTERY_NOTIFICATION_FILE ]]; then
      mkdir -p "$(dirname "$LOW_BATTERY_NOTIFICATION_FILE")"
      if can_lower_power_profile; then
        notify-send -a System \
          -i "$LUCIDE_PATH/battery-low.svg" \
          -h string:wired-tag:battery-low \
          -h boolean:x-power-profile-can-lower:true \
          -h int:value:"$charge" \
          "Battery low" "$charge% remaining"
      else
        notify-send -a System \
          -i "$LUCIDE_PATH/battery-low.svg" \
          -h string:wired-tag:battery-low \
          -h int:value:"$charge" \
          "Battery low" "$charge% remaining"
      fi
      : > "$LOW_BATTERY_NOTIFICATION_FILE"
    fi
  fi

  if [[ $charge -le ${CRITICAL_BATTERY_THRESHOLDS[0]} ]]; then
    mkdir -p "$BATTERY_NOTIFICATION_DIR"
    for threshold in "${CRITICAL_BATTERY_THRESHOLDS[@]}"; do
      marker="$BATTERY_NOTIFICATION_DIR/$threshold"
      if [[ $charge -le $threshold && ! -e $marker ]]; then
        notify-send -u critical -t 86400000 -a System \
          -i "$LUCIDE_PATH/battery-warning.svg" \
          -h string:wired-tag:battery-critical \
          -h int:value:"$charge" \
          "Battery critical" "$charge% remaining - plug in now"
        : > "$marker"
      fi
    done
  else
    rm -f "$LOW_BATTERY_NOTIFICATION_FILE"
    rm -rf "$BATTERY_NOTIFICATION_DIR"
  fi
}

can_lower_power_profile() {
  if busctl --system --no-pager list 2>/dev/null | grep -q '^org\.freedesktop\.UPower\.PowerProfiles[[:space:]]'; then
    command -v powerprofilesctl >/dev/null || return 1
    case $(powerprofilesctl get 2>/dev/null) in
      performance|balanced) return 0 ;;
      *) return 1 ;;
    esac
  fi

  command -v u_performance-profile >/dev/null || return 1
  local current
  current=$(u_performance-profile get 2>/dev/null) || return 1
  local profile found_current=false
  while IFS= read -r profile; do
    if [[ $found_current == true ]]; then
      return 0
    fi
    [[ $profile == "$current" ]] && found_current=true
  done < <(u_performance-profile list 2>/dev/null)
  return 1
}

lower_power_profile() {
  if busctl --system --no-pager list 2>/dev/null | grep -q '^org\.freedesktop\.UPower\.PowerProfiles[[:space:]]'; then
    case $(powerprofilesctl get 2>/dev/null) in
      performance) powerprofilesctl set balanced ;;
      balanced) powerprofilesctl set power-saver ;;
      *) return 1 ;;
    esac
    return
  fi

  u_performance-profile prev
}

case $1 in
  if) upower -i "$(upower -e | grep 'BAT')" ;;
  icon) echo "$(icon)" ;;
  show) show_battery ;;
  icon_and_warn) warn && icon ;;
  get) echo -e "$(get)" ;;
  warn) warn ;;
  power) power "$2" "$3" "${4:-charging}" ;;
  lower-profile) lower_power_profile ;;
esac
