[Unit]
Description=Quickshell shell (bar, control center, notifications)
Documentation=https://quickshell.outfoxxed.me
# Started explicitly by i3 after its display and IPC environment are imported.
ConditionEnvironment=DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/newgrp nordvpn --command %h/dotfiles/linux/scripts/quickshell
Restart=always
RestartSec=5
