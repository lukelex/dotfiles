[Unit]
Description=Quickshell shell (bar, control center, notifications)
Documentation=https://quickshell.outfoxxed.me
# Started explicitly by the active i3 or Hyprland session after its environment is imported.

[Service]
Type=simple
ExecStart=%h/dotfiles/linux/config/quickshell/scripts/quickshell
Restart=always
RestartSec=5
# Restart the shell if memory grows unchecked; a soft limit can stall the UI
# thread in reclaim indefinitely instead of letting the hard limit take effect.
MemoryMax=2G
MemorySwapMax=128M
OOMPolicy=kill
