[Unit]
Description=Quickshell shell (bar, control center, notifications)
Documentation=https://quickshell.outfoxxed.me
# Started explicitly by the active i3 or Hyprland session after its environment is imported.

[Service]
Type=simple
ExecStart=/usr/bin/newgrp nordvpn --command %h/dotfiles/linux/config/quickshell/scripts/quickshell
Restart=always
RestartSec=5
