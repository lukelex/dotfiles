[Unit]
Description=KMonad ThinkPad keyboard configuration
Documentation=https://github.com/kmonad/kmonad
ConditionPathExists=/dev/input/by-path/platform-i8042-serio-0-event-kbd
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/kmonad %h/dotfiles/linux/config/kmonad/thinkpad.kbd
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
