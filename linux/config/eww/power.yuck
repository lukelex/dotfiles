(defvar power_cursor 0)

(defwidget power-action [index icon cmd label]
  (pointer :active true
    (button :class "button power-action ${power_cursor == index ? "selected" : ""}"
            :onclick { "${cmd} & u_eww close &" }
            :tooltip label
      (icon-large :name icon)
    )
  )
)

(defwindow power :monitor 0
                 :stacking "fg"
                 :wm-ignore true
                 :geometry (geometry :anchor "center")
  (v-window
    (box :class "panel power-menu"
         :orientation "horizontal"
         :spacing (SPACING * 2)
         :space-evenly false
      (power-action :index 0 :icon "lock"            :cmd "u_exit lock"     :label "Lock (l)")
      (power-action :index 1 :icon "moon-star"           :cmd "u_exit suspend"  :label "Suspend (s)")
      (power-action :index 2 :icon "log-out" :cmd "u_exit logout" :label "Logout (o)")
      (power-action :index 3 :icon "refresh-cw"    :cmd "u_exit reboot"   :label "Reboot (r)")
      (power-action :index 4 :icon "circle-power"        :cmd "u_exit shutdown" :label "Shutdown (p)")
    )
  )
)