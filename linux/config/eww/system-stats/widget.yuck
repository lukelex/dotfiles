(defpoll system_stats :interval "5s" :initial "{\"disk\":{\"used_perc\":0},\"cpu\":{\"avg\":0},\"ram\":{\"used_mem_perc\":0}}" `./scripts/system-stats`)

(defwidget system-stats []
  (box :class "system-stats-panel panel"
       :spacing SPACING :orientation "horizontal"
       :space-evenly true :hexpand true
    (box :space-evenly false :halign "center"
      (circular-progress :class "stat low" :thickness 5 :clockwise true
                         :value { system_stats.disk.used_perc }
        (button :class "big-button" :tooltip "Disk ${system_stats.disk.used_perc}%"
          (icon :name "hard-drive")
        )
      )
    )
    (box :space-evenly false :halign "center"
      (circular-progress :class "stat low" :thickness 5 :clockwise true
                         :value { round(system_stats.cpu.avg, 0) }
        (button :class "big-button" :tooltip "CPU ${system_stats.cpu.avg}%"
          (icon :name "microchip")
        )
      )
    )
    (box :space-evenly false :halign "center"
      (circular-progress :class "stat low" :thickness 5 :clockwise true
                         :value { system_stats.ram.used_mem_perc }
        (button :class "big-button" :tooltip "RAM ${system_stats.ram.used_mem_perc}%"
          (icon :name "memory-stick")
        )
      )
    )
  )
)