(defpoll brightness_value :interval "1s" :initial 50 `u_backlight get`)
(defpoll keeb_level     :interval "1s" :initial 1 `u_keeb-backlight level`)
(defpoll keeb_steps     :interval "2s" :initial 2 `u_keeb-backlight steps`)
(defpoll keeb_pct       :interval "1s" :initial 100 `u_keeb-backlight get`)
(defpoll keeb_stepped   :interval "2s" :initial true `u_keeb-backlight stepped`)
(defpoll keeb_continuous :interval "2s" :initial false `u_keeb-backlight continuous`)
(defpoll external_present :interval "2s" :initial false `u_monitors brightness if`)
(defpoll external_value :interval "2s" :initial -1 `u_monitors brightness get`)
(defpoll night_state    :interval "3s" :initial false `u_nightmode get`)
(defpoll auto_state     :interval "3s" :initial false `u_autobright get`)
(defpoll link_state     :interval "3s" :initial false `u_backlight link-get`)

(defwindow backlights :monitor 0
                      :stacking "fg"
                      :wm-ignore true
                      :geometry (geometry :x "-20px"
                                          :y "66px"
                                          :anchor "top right")
  (v-window
    (box :spacing SPACING
         :class "panel"
         :orientation "vertical"
         :space-evenly false
      (box :spacing SPACING
           :orientation "horizontal"
        (toggle-action :icon "brightness"
                       :script "u_autobright toggle"
                       :enabled auto_state
                       :text "Auto")
        (toggle-action :icon "moon"
                       :script "u_nightmode toggle"
                       :enabled night_state
                       :text "Night")
        (toggle-action :icon "sun"
                       :script "u_backlight link-toggle"
                       :enabled link_state
                       :text "Link")
      )
      (box :class "h-spacer" :hexpand true)
      (slider-setter :icon "laptop"
                     :tooltip "Laptop display (${brightness_value}%)"
                     :script "u_backlight set"
                     :value brightness_value)
      (box :spacing SPACING
           :orientation "horizontal"
           :space-evenly false
           :visible { external_present }
        (slider-setter :icon "display"
                       :tooltip "External displays (${external_value}%)"
                       :script "u_monitors brightness set"
                       :value external_value)
      )
      (box :spacing SPACING
           :orientation "horizontal"
           :space-evenly false
           :visible { keeb_continuous }
        (slider-setter :icon "keyboard-brightness"
                       :tooltip "Keyboard brightness (${keeb_pct}%)"
                       :script "u_keeb-backlight set"
                       :value keeb_pct)
      )
    )
  )
)