[Unit]
Description=Widget system (ElKowar's Wacky Widgets)
Documentation=https://github.com/elkowar/eww
After=graphical.target

[Install]
WantedBy=default.target

[Service]
Type=oneshot
RemainAfterExit=true
StandardOutput=journal
EnvironmentFile=%h/Dropbox/secrets.env
# EnvironmentFile does not expand $VAR inside values, so set the values
# eww needs explicitly using %h specifiers.
Environment=XDG_CONFIG_HOME=%h/.config
ExecStartPre=/bin/bash %h/dotfiles/linux/scripts/eww prepare
ExecStart=/usr/bin/eww daemon
ExecStop=/usr/bin/eww kill
ExecStartPre=/bin/sleep 1
