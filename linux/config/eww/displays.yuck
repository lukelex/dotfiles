(defpoll profile_list :interval "3s" :initial "[]" `u_displays list`)
(defpoll layout_rows  :interval "3s" :initial "[]" `u_displays layouts`)

(defwidget profile-entry [profile]
  (pointer :active { profile.available }
    (button :class "button display-entry ${profile.available ? "" : "unavailable"} ${profile.active ? "active" : ""}"
            :onclick { profile.available ? "u_displays load ${profile.name} &" : "" }
      (box :orientation "horizontal"
           :hexpand true
           :spacing SPACING
           :space-evenly false
        (box :halign "start"
             :hexpand true
             :space-evenly false
             :spacing SPACING
          (label :class "text"
                 :halign "start"
                 :text { profile.name }
          )
        )

        (box :halign "end"
             :space-evenly false
             :style "min-width: ${ICON_SIZE_SMALL}px"
          (box :visible { profile.active }
            (icon-small :name "circle-check")
          )
        )
      )
    )
  )
)

(defwidget layout-tile [layout]
  (pointer :active { layout.available }
    (button :class "button display-entry layout-tile ${layout.available ? "" : "unavailable"} ${layout.active ? "active" : ""}"
            :onclick { layout.available ? "u_displays load ${layout.name} &" : "" }
            :tooltip { layout.available ? layout.label : "" }
      (icon-medium :name { layout.icon })
    )
  )
)

(defwidget layout-row [row]
  (box :spacing SPACING
       :orientation "horizontal"
       :space-evenly true
    (for layout in row
      (layout-tile :layout layout)
    )
  )
)

(defwindow displays :monitor 0
                    :stacking "fg"
                    :wm-ignore true
                    :geometry (geometry :x "-20px"
                                        :y "66px"
                                        :anchor "top right")
  (v-window
    (box :spacing SPACING
         :orientation "vertical"
         :space-evenly false
         :style "min-width: 400px"
      (module-section :icon "monitor"
                      :title "Profiles"
        (box :orientation "vertical"
             :space-evenly false
             :spacing SPACING
          (for profile in profile_list
            (profile-entry :profile profile)
          )
        )
      )
      (module-section :icon "sliders"
                      :title "Layouts"
        (box :spacing SPACING
             :orientation "vertical"
             :space-evenly false
          (for row in layout_rows
            (layout-row :row row)
          )
        )
      )
    )
  )
)