#!/usr/bin/bash

set -eu

ip=$(curl -4 --fail --silent --show-error --connect-timeout 5 --max-time 5 https://ipwho.is \
  | jq -er '.ip | strings')
[[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || exit 1
IFS=. read -r a b c d <<< "$ip"
(( a <= 255 && b <= 255 && c <= 255 && d <= 255 )) || exit 1
printf '%s\n' "$ip"
