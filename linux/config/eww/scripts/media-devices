#!/bin/env ruby

require "json"
require "open3"
require "shellwords"

def command_output(*command)
  output, status = Open3.capture2(*command)
  status.success? ? output : ""
end

def active_default(source)
  key = source ? "default.audio.source" : "default.audio.sink"
  meta = command_output("pw-metadata", "-n", "default")
  json = meta[/key:'#{Regexp.escape(key)}' value:'([^']*)'/, 1]

  JSON.parse(json)["name"] if json
rescue JSON::ParserError
  nil
end

def node_ids
  nodes = JSON.parse(command_output("pw-dump"))

  nodes.each_with_object({}) do |node, map|
    next unless node["type"] == "PipeWire:Interface:Node"

    name = node.dig("info", "props", "node.name")
    map[name] = node["id"] if name
  end
rescue JSON::ParserError
  {}
end

def pactl_blocks(kind)
  blocks = []
  current = []

  command_output("pactl", "list", "#{kind}s").each_line do |line|
    if line =~ /^(Sink|Source) #\d+/
      blocks << current.join if current.any?
      current = [line]
    else
      current << line
    end
  end

  blocks << current.join if current.any?
  blocks
end

def parse_device(block)
  {
    id: block[/^(?:Sink|Source) #(\d+)/, 1].to_i,
    name: block[/^\tName: (.+)/, 1],
    description: block[/^\tDescription: (.+)/, 1],
    api: block[/device\.api\s*=\s*"([^"]+)"/, 1],
    profile: block[/device\.profile\.name\s*=\s*"([^"]+)"/, 1]
  }
end

def icon_for(device, input)
  if device[:name].to_s.start_with?("bluez_") || device[:api] == "bluez5"
    ["bluetooth", "Bluetooth"]
  elsif input
    ["mic", "Microphone"]
  elsif device[:description].to_s =~ /hdmi|displayport/i || device[:profile].to_s =~ /hdmi/i
    ["clapperboard", "HDMI"]
  elsif device[:description].to_s =~ /headset|headphone/i
    ["headset", "Headset"]
  elsif device[:description].to_s =~ /usb|dac/i
    ["headphones", "External"]
  else
    ["speaker", "Speakers"]
  end
end

def audio_devices(kind, source)
  default = active_default(source)
  ids = node_ids

  pactl_blocks(kind).filter_map do |block|
    device = parse_device(block)
    next unless device[:name]
    next if source && device[:name].end_with?(".monitor")

    icon = icon_for(device, source)
    wpctl_id = ids[device[:name]]
    metadata_key = source ? "default.audio.source" : "default.audio.sink"

    cmd = if wpctl_id.is_a?(Integer)
            payload = Shellwords.shellescape(JSON.generate(name: device[:name]))
            "wpctl set-default #{wpctl_id} && pw-metadata -n default 0 #{Shellwords.shellescape(metadata_key)} #{payload} >/dev/null"
          else
            ""
          end

    {
      id: device[:id],
      default: device[:name] == default,
      name: device[:description] || device[:name],
      icon: icon[0],
      kind: icon[1],
      cmd: cmd
    }
  end
end

def video_devices
  raw = `wpctl status`.split("\n\n")[2].to_s
  paragraph = raw[/Sources:\n(.*?)(?=\n\s*[├└]─)/m, 1].to_s

  paragraph
    .scan(/^\s*[│|]?\s*(\*)?\s*(\d+)\.\s+(.*?)\s*$/)
    .filter_map do |default, id, name|
      next if name.empty?

      {
        id: id.to_i,
        default: !default.nil?,
        name: name,
        icon: "webcam",
        kind: "Camera",
        cmd: ""
      }
    end
    .uniq { |device| device[:name] }
end

puts JSON.dump \
  case ARGV.first
  when "output" then audio_devices("sink", false)
  when "input" then audio_devices("source", true)
  when "video" then video_devices
  end
