#!/bin/env ruby

require "json"
require "date"

HIDE_LIST = [
  "info",
  "spotify",
  "volume",
  "brightness",
  "flameshot",
  "power manager",
  "package manager",
  "networkmanager applet",
  "microphone",
  "notify-send",
  "system"
].freeze

WIRED_LOG = ENV.fetch("WIRED_LOG", "/tmp/wired.log").freeze

def valid_entry?(entry)
  entry.is_a?(Hash) &&
    %w[app_name summary body].all? { |field| entry[field].is_a?(String) } &&
    entry["time"].is_a?(Numeric)
end

def enrich(entry)
  entry.merge(
    {
      "icon" => Icon.for(entry),
      "app_name" => entry.fetch("app_name").capitalize,
      "timestamp" => Time.at(entry.fetch("time")).strftime("%m/%d %H:%M")
    }
  )
end

module Icon
  extend self

  ICONS = [
    {
      body: /was saved in/,
      icon: "key"
    },
    {
      name: "Printers",
      icon: "printer"
    },
    {
      name: "Google Chrome",
      icon: "globe"
    },
    {
      name: ["Telegram Desktop", "discord", "Slack", "WhatsApp"],
      icon: "message-square"
    },
    {
      name: "blueman",
      icon: "bluetooth"
    }
  ].freeze

  def for(entry)
    ICONS.find do |icon|
      in_name?(icon, entry) ||
        in_app_name?(icon, entry) ||
        in_body?(icon, entry)
    end&.fetch(:icon, "bell") || "bell"
  end

  private

  def in_name?(icon, entry)
    Array(icon[:name]).include?(entry.fetch("app_name"))
  end

  def in_app_name?(icon, entry)
    Array(icon[:name]).any? { |n| entry.fetch("app_name").downcase.include?(n.downcase) }
  end

  def in_body?(icon, entry)
    icon[:body]&.match?(entry.fetch("body"))
  end
end

entries = if File.readable?(WIRED_LOG)
            File.foreach(WIRED_LOG).filter_map do |line|
              entry = JSON.parse(line)
              entry if valid_entry?(entry)
            rescue JSON::ParserError
              nil
            end
          else
            []
          end

puts entries
  .select { |entry| (entry.values_at("app_name", "summary").map(&:downcase) & HIDE_LIST).empty? }
  .sort_by { |entry| entry.fetch("time") }
  .reverse
  .first(25)
  .map(&method(:enrich))
  .to_json
