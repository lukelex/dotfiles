(defpoll output_devices :interval "2s" :initial "[]" `./scripts/media-devices output`)
(defpoll input_devices :interval "2s" :initial "[]" `./scripts/media-devices input`)
(defpoll video_devices :interval "2s" :initial "[]" `./scripts/media-devices video`)

(defwindow media-devices :monitor 0
                         :stacking "fg"
                         :wm-ignore true
                         :geometry (geometry :x "-20px"
                                             :y "66px"
                                             :anchor "top right")
  (v-window
    (box :orientation "vertical"
         :space-evenly false
         :spacing SPACING
         :style "min-width: 500px"
      (devices-module :title "Audio Output"
                      :icon "speakers"
                      :devices output_devices)
      (devices-module :title "Audio Input"
                      :icon "microphone"
                      :devices input_devices)
      (devices-module :title "Video"
                      :icon "camera-web"
                      :devices video_devices)
    )
  )
)

(defwidget devices-module [title icon devices]
  (box :class "media-device-panel panel"
       :hexpand true
       :spacing SPACING
       :orientation "vertical"
       :space-evenly false
       :visible { arraylength(devices) != 0 }
    (box :orientation "horizontal"
         :hexpand true
         :valign "center"
      (box :halign "start"
           :space-evenly false
           :spacing SPACING
        (icon-small :name icon)
        (title :text title)
      )

      (box :halign "end"
           :space-evenly false
           :spacing SPACING
        (pointer :active true
          (button :class "button" :onclick "pavucontrol & u_eww close &"
            (icon-small :name "gear")
          )
        )
      )
    )

    (box :orientation "vertical"
         :style "border: 2px solid grey; padding: 4px; border-radius: 4px;"
         :spacing SPACING
      (for device in devices
        (device-entry :device device)
      )
    )
  )
)

(defwidget device-entry [device]
  (pointer :active true
    (button :class "button" :onclick { device.cmd }
      (box :orientation "horizontal"
           :hexpand true
           :spacing SPACING
           :space-evenly false
        (box :halign "start"
             :hexpand true
             :space-evenly false
             :spacing SPACING
          (icon-small :name { device.icon })
          (box :orientation "vertical"
            (label :class "text"
                   :halign "start"
                   :text { device.name }
                   :limit-width 40
            )
            (label :class "text"
                   :halign "start"
                   :text { device.kind }
            )
          )
        )

        (box :halign "end"
             :space-evenly false
             :style "min-width: ${ICON_SIZE_SMALL}px"
          (box :visible { device.default }
            (icon-small :name "circle-check")
          )
        )
      )
    )
  )
)
