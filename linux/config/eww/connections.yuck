(defpoll wifi_data :interval "2s"
  :initial "{\"ssid\":\"\",\"signal\":\"\",\"rate\":\"\",\"down\":\"0.00 MB/s\",\"up\":\"0.00 MB/s\",\"ip\":\"\"}"
  `./scripts/wifi`)
(defpoll wifi_public_ip :interval "600s" `./scripts/public-ip`)
(defpoll bt_devices :interval "5s" :initial "[]" `./scripts/bluetooth`)
(defpoll bt_powered :interval "5s" `bluetoothctl show | grep "Powered: yes" | awk '{print $2}'`)
(defpoll wifi_powered :interval "5s" `nmcli -t radio wifi`)
(defpoll eth_data :interval "5s"
  :initial "{\"connected\":false,\"name\":\"\",\"ip\":\"\"}"
  `./scripts/ethernet`)

(defwindow connections :monitor 0
                       :stacking "fg"
                       :wm-ignore true
                       :geometry (geometry :x "-26px"
                                           :y "72px"
                                           :anchor "top right")
  (v-window
    (box :orientation "vertical"
         :space-evenly false
         :spacing SPACING
         :style "min-width: 450px"
      (box :spacing SPACING
           :class "panel"
           :orientation "vertical"
           :space-evenly false
      (toggleable-module :name "Wifi"
                         :icon "wifi"
                         :app "nm-connection-editor"
                         :script "nmcli radio wifi"
                         :enabled { wifi_powered == "enabled" }
                         :expanded { strlength(wifi_data.ssid) != 0 }
        (box :orientation "horizontal"
             :hexpand true
          (box :halign "start"
               :space-evenly false
               :spacing SPACING
            (icon-small :name "router")
            (label :class "text"
                   :text { wifi_data.ssid }
                   :limit-width 16
            )
          )
          (box :halign "start"
               :space-evenly false
               :spacing SPACING
            (icon-small :name "signal")
            (label :class "text"
                   :text { strlength(wifi_data.signal) != 0 ? "${wifi_data.signal} (${wifi_data.rate})" : "" }
            )
          )
        )
        (box :orientation "horizontal"
             :hexpand true
          (box :halign "start"
               :space-evenly false
               :spacing SPACING
            (icon-small :name "circle-down")
            (label :class "text"
                   :text { wifi_data.down }
            )
          )
          (box :halign "start"
               :space-evenly false
               :spacing SPACING
            (icon-small :name "circle-up")
            (label :class "text"
                   :text { wifi_data.up }
            )
          )
        )
        (box :orientation "horizontal"
             :hexpand true
          (box :halign "start"
               :space-evenly false
               :spacing SPACING
            (icon-small :name "network-wired")
            (label :class "text"
                   :text { wifi_data.ip }
            )
          )
          (box :halign "start"
               :space-evenly false
               :spacing SPACING
            (icon-small :name "globe")
            (label :class "text"
                   :text wifi_public_ip
            )
          )
        )
      )
    )
    (box :spacing SPACING
         :class "panel"
         :orientation "vertical"
         :space-evenly false
      (toggleable-module :name "Bluetooth"
                         :icon "bluetooth"
                         :app "blueman-manager"
                         :script "bluetoothctl power"
                         :enabled { bt_powered == "yes" }
                         :expanded { arraylength(bt_devices) != 0 }
        (box :orientation "vertical"
             :space-evenly false
             :spacing SPACING
          (for device in bt_devices
            (bluetooth-device :device device)
          )
        )
      )
    )
    (box :spacing SPACING
         :class "panel"
         :orientation "vertical"
         :space-evenly false
      (toggleable-module :name "Ethernet"
                         :icon "ethernet"
                         :app "nm-connection-editor"
                         :script "true"
                         :enabled { eth_data.connected }
                         :expanded true
        (box :orientation "horizontal"
             :hexpand true
          (box :halign "start"
               :space-evenly false
               :spacing SPACING
            (icon-small :name "ethernet")
            (label :class "text"
                   :text { eth_data.connected ? eth_data.name : "Disconnected" }
                   :limit-width 20
            )
          )
          (box :halign "end"
               :space-evenly false
               :spacing SPACING
               :visible { eth_data.connected }
            (icon-small :name "network-wired")
            (label :class "text"
                   :text { eth_data.ip }
            )
          )
        )
      )
    )
    )
  )
)

(defwidget bluetooth-device [device]
  (box :orientation "horizontal"
       :hexpand true
    (box :halign "start"
         :space-evenly false
         :spacing SPACING
      (icon-small :name "arrows-to-dotted-line")
      (label :class "text"
             :text { device.name }
             :limit-width 20
      )
    )
    (box :halign "end"
         :space-evenly false
         :spacing SPACING
         :visible { strlength(device.battery) != 0 }
      (icon-small :name "battery-half")
      (label :class "text"
             :text { device.battery }
      )
    )
  )
)

(defwidget toggleable-module [name icon app ?script enabled expanded]
  (box :orientation "vertical"
       :space-evenly false
       :spacing SPACING
    (box :orientation "horizontal"
         :valign "center"
      (box :halign "start"
           :space-evenly false
           :spacing SPACING
        (icon-small :name icon)
        (title :text name)
      )

      (box :halign "end"
           :space-evenly false
           :spacing SPACING
        (quick-toggler :script {script}
                       :tooltip ""
                       :enabled enabled
                       :close false)
        ; (pointer :active true
        ;   (button :class "button" :onclick ""
        ;     (icon-small :name "info")
        ;   )
        ; )
        ; (pointer :active true
        ;   (button :class "button" :onclick "${app} & u_eww close &"
        ;     (icon-small :name "gear")
        ;   )
        ; )
      )
    )

    (revealer :transition "slidedown"
              :reveal expanded
              :visible expanded
      (box :orientation "vertical"
         :style "border: 2px solid grey; padding: 4px; border-radius: 4px;"
         :spacing SPACING
        (box :orientation "vertical"
           :style "border: 2px solid grey; padding: 4px; border-radius: 4px;"
           :spacing SPACING
          (children)
        )
      )
    )
  )
)
; monitor icon
; object-union
; object-subtract
; object-intersect
; object-exclude
