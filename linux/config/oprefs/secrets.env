# Shared environment-variable secret references for 1Password.
#
# This file holds NO secrets — only op:// references, which the 1Password CLI
# resolves per machine. Safe to commit. Consumed by:
#   - linux/scripts/op-run (installed as u_op-run) for one-off commands/scripts
#   - linux/config/zsh/secrets.zsh, which exports these into every interactive
#     zsh at startup
#
# Per-host overrides: add a second file named secrets.<short-hostname>.env in
# this directory (e.g. secrets.archqms.env). It is loaded after this file, so
# its values win. This mirrors the linux/hosts/<name>.yaml manifest pattern.
#
# Format — one KEY=VALUE per line; VALUE is a 1Password secret reference:
#   KEY=op://VaultName/ItemName/field
#   KEY=op://VaultName/ItemName/section/field
#
# Generate references from the 1Password app (right-click an item field >
# "Copy secret reference") or with the CLI:
#   op item get <item> --vault <vault> --format=json \
#     | jq -r '.fields[] | "\(.label)=\(.reference)"'
#
# Examples (uncomment and replace with your own references):
# GITHUB_TOKEN=op://Personal/Shared Secrets/github/token
# OPENAI_API_KEY=op://Personal/Shared Secrets/openai/api-key

QUOTES_API_KEY=op://Shared Secrets/Quotes API/QUOTES_API_KEY
OPEN_WEATHER_API_KEY=op://Shared Secrets/Open Weather/OPEN_WEATHER_API_KEY

LINEAR_API_KEY=op://Shared Secrets/Linear/LINEAR_API_KEY
