#!/usr/bin/bash

/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
nm-applet &

1password --silent &
dropbox start -i &
playerctld daemon &
udiskie -a &
seadrive-gui &

if command -v u_battery-policy > /dev/null 2>&1
then
  u_battery-policy &
fi

case "$XDG_SESSION_TYPE" in
  wayland)
    "$HOME/dotfiles/linux/config/quickshell/scripts/quickshell" --session-start &
    python3 "$HOME/dotfiles/linux/config/system-settings/monitors.py" watch &
    awww-daemon &

    python3 "$HOME/dotfiles/linux/config/system-settings/settings.py" run-idle &
    ;;
  *)
    python3 "$HOME/dotfiles/linux/config/system-settings/monitors.py" watch &

    xss-lock --transfer-sleep-lock -- u_exit lock &

    sxhkd -c "$HOME/dotfiles/linux/config/sxhkdrc" &

    flameshot &
    greenclip daemon &

    u_i3-workspaces &
    ;;
esac

if command -v u_wallpaper &> /dev/null
then
  u_wallpaper random "$HOME/Dropbox/wallpapers/32x9" &> /dev/null &
fi
