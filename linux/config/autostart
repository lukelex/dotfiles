#!/usr/bin/bash

/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
nm-applet &

python3 "$HOME/dotfiles/linux/config/system-settings/session-idle.py" start

1password --silent &
bash "$HOME/dotfiles/linux/install/resume" &
dropbox start -i &
playerctld daemon &
python3 "$HOME/dotfiles/linux/config/system-settings/usb-storage.py" startup &
seadrive-gui &

if command -v u_battery-policy > /dev/null 2>&1
then
  u_battery-policy &
fi

case "$XDG_SESSION_TYPE" in
  wayland)
    "$HOME/dotfiles/linux/config/quickshell/scripts/quickshell" --session-start &
    python3 "$HOME/dotfiles/linux/config/system-settings/monitors.py" watch &
    awww-daemon &

    ;;
  *)
    python3 "$HOME/dotfiles/linux/config/system-settings/monitors.py" watch &

    sxhkd -c "$HOME/dotfiles/linux/config/sxhkdrc" &

    flameshot &
    greenclip daemon &

    u_i3-workspaces &
    ;;
esac

if command -v u_wallpaper &> /dev/null
then
  python3 "$HOME/dotfiles/linux/config/system-settings/wallpaper.py" startup &> /dev/null &
fi
