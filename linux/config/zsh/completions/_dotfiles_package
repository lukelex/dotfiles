#compdef package

_dotfiles_package_names() {
  local -a packages

  (( $+commands[pacman] )) || return
  packages=("${(@f)$(pacman -Slq 2>/dev/null | sort -u)}")
  _describe -t packages package packages
}

_dotfiles_package_scopes() {
  local option
  local -a options scopes

  options=("${(@f)$("$DOTFILES/linux/install/yq" -r '.profiles.desktop.options | keys[]' "$DOTFILES/linux/packages.yaml" 2>/dev/null)}")
  scopes=(common desktop server hyprland i3 extras)
  for option in "${options[@]}"; do
    scopes+=("option:$option")
  done
  _describe -t scopes scope scopes
}

_dotfiles_package_hosts() {
  local -a hosts

  hosts=("$DOTFILES"/linux/hosts/*.yaml(N:t:r))
  _describe -t hosts host hosts
}

_dotfiles_package() {
  local command=${words[2]:-}

  if (( CURRENT == 2 )); then
    _values 'package command' \
      'add[declare, validate, install, and track a package]' \
      'sync[reconcile packages only]' \
      'validate[validate manifest packages]'
    return
  fi

  case $command in
    add)
      _arguments -S \
        '1:package:_dotfiles_package_names' \
        '--scope=[manifest scope]:scope:_dotfiles_package_scopes' \
        '--host=[host overlay]:host:_dotfiles_package_hosts' \
        '--desktop[reconcile the desktop profile]' \
        '--server[reconcile the server profile]' \
        '--dry-run[validate and print planned changes]' \
        '--help[show help]'
      ;;
    sync)
      _arguments -S \
        '--host=[host overlay]:host:_dotfiles_package_hosts' \
        '--desktop[reconcile the desktop profile]' \
        '--server[reconcile the server profile]' \
        '--dry-run[print planned changes]' \
        '--help[show help]'
      ;;
    validate)
      _arguments -S \
        '*--package=[additional package]:package:_dotfiles_package_names' \
        '--host=[host overlay]:host:_dotfiles_package_hosts' \
        '--desktop[validate the desktop profile]' \
        '--server[validate the server profile]' \
        '--help[show help]'
      ;;
  esac
}
