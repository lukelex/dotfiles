[user]
	email = the.lukelex@gmail.com
	name = Lukas Alexandre
[core]
	pager = less --tabs=4 -RFX
[pager]
	diff = hunk-pager
	show = hunk-pager
[diff]
	context = 2
[color]
	ui = true
[color "diff"]
	meta = yellow
	frag = normal dim
	commit = yellow bold
	old = red
	new = green
	whitespace = red reverse
[init]
	defaultBranch = main
[rebase]
	autosquash = true
[push]
	default = current
[pull]
	rebase = true
