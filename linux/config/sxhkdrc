XF86PowerOff
  u_eww toggle power

# Power menu keyboard navigation (after the power key)
XF86PowerOff; Left
  u_power prev
XF86PowerOff; Right
  u_power next
XF86PowerOff; Return
  u_power select
XF86PowerOff; Escape
  u_eww close
XF86PowerOff; l
  u_power run lock
XF86PowerOff; s
  u_power run suspend
XF86PowerOff; o
  u_power run logout
XF86PowerOff; r
  u_power run reboot
XF86PowerOff; p
  u_power run shutdown

XF86AudioPrev
  u_music previous
XF86AudioNext
  u_music next

XF86AudioMicMute
  u_audio mic toggle
XF86AudioMute
  u_audio vol toggle; u_audio vol show
XF86AudioRaiseVolume
  u_audio vol inc; u_audio vol show
XF86AudioLowerVolume
  u_audio vol dec; u_audio vol show
XF86AudioPlay
  u_music toggle

XF86MonBrightnessUp
  "$HOME/dotfiles/linux/scripts/x86bright" inc
@XF86MonBrightnessUp
  "$HOME/dotfiles/linux/scripts/x86bright" stop inc
XF86MonBrightnessDown
  "$HOME/dotfiles/linux/scripts/x86bright" dec
@XF86MonBrightnessDown
  "$HOME/dotfiles/linux/scripts/x86bright" stop dec

XF86KbdBrightnessUp
  u_keeb-backlight inc
XF86KbdBrightnessDown
  u_keeb-backlight dec

super + shift + q
  xkill

super + ctrl + l
  u_exit lock

super + d
  rofi -show drun

super + Return
  kitty

super + shift + p
  systemctl --user restart quickshell.service

Print
  flameshot gui -c -p "$HOME/screenshots"
shift + Print
  flameshot screen -c -p "$HOME/screenshots"

super + ctrl+ b
  rofi-bluetooth
super + ctrl + c
  u_clipboard
super + ctrl + f
  kitty yazi
super + ctrl + p
  1password --quick-access

super + shift + s
  pkill -usr1 -x sxhkd
