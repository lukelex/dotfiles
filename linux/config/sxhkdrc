XF86PowerOff
  u_exit lock

XF86AudioPrev
  u_music previous
XF86AudioNext
  u_music next

XF86AudioMicMute
  u_audio mic toggle
XF86AudioMute
  u_audio vol toggle; u_audio vol show
XF86AudioRaiseVolume
  u_audio vol inc; u_audio vol show
XF86AudioLowerVolume
  u_audio vol dec; u_audio vol show
XF86AudioPlay
  u_music toggle

XF86MonBrightnessUp
  u_backlight inc
XF86MonBrightnessDown
  u_backlight dec

XF86KbdBrightnessUp
  u_keeb-backlight inc
XF86KbdBrightnessDown
  u_keeb-backlight dec

super + shift + q
  xkill

super + ctrl + l
  u_exit lock

super + d
  rofi -show drun

super + Return
  kitty

super + shift + p
  systemctl --user restart quickshell.service

Print
  flameshot gui -c -p "$HOME/screenshots"
shift + Print
  flameshot screen -c -p "$HOME/screenshots"

super + ctrl+ b
  rofi-bluetooth
super + ctrl + c
  u_clipboard
super + ctrl + f
  kitty yazi
super + ctrl + p
  1password --quick-access

super + shift + s
  pkill -usr1 -x sxhkd
