DOTFILES="$HOME/dotfiles"
XDG_CONFIG_HOME="$HOME/.config"
DOT_CONFIG="$DOTFILES/linux/config"

TERMINFO='/usr/share/terminfo'
TERM="xterm-kitty"
KITTY_CONFIG_DIRECTORY="$DOTFILES/linux/config/kitty"
BAT_PAGER='less -RFI'
MANPAGER='nvim +Man!'
FZF_DEFAULT_OPTS="--layout=reverse --border --header 'Ctrl+h: PageDown / Ctrl+l: PageUp' --bind ctrl-h:page-down,ctrl-l:page-up"

EDITOR='nvim'
BROWSER=/usr/bin/google-chrome-stable
QT_QPA_PLATFORMTHEME="qt5ct"
QT_STYLE_OVERRIDE="kvantum"
GTK2_RC_FILES="$HOME/.gtkrc-2.0"
FONT_AWESOME_PATH="$DOTFILES/fonts/fa6/svgs"
LUCIDE_PATH="$DOTFILES/linux/config/lucide/svg"
LUCIDE_PNG_PATH="$DOTFILES/linux/config/lucide/png"

# Cursor Theming
CURSOR_THEME='Bibata-Modern-Amber'
CURSOR_SIZE=28

THEME_STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/color-scheme"
