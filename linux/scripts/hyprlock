#!/usr/bin/bash

set -Eeuo pipefail

dotfiles="$HOME/dotfiles"
template="$dotfiles/linux/config/hypr/hyprlock.conf"
theme_file="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/color-scheme"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
config="$cache_dir/hyprlock.conf"
primary_monitor=$(hyprctl monitors -j 2> /dev/null | jq -r '.[] | select(.focused) | .name' 2> /dev/null | head -n 1 || true)
monitor_size=$(hyprctl monitors -j 2> /dev/null \
  | jq -r '.[] | select(.focused) | "\(.width) \(.height)"' 2> /dev/null \
  | head -n 1 || true)
read -r monitor_width monitor_height <<< "${monitor_size:-1920 1080}"
if [ "${monitor_height:-1080}" -gt "${monitor_width:-1920}" ]; then
  side_margin=24
  notification_size=440
  notification_offset=-16
else
  side_margin=36
  notification_size=600
  notification_offset=-32
fi

wallpaper="$HOME/wallpaper.png"
wallpaper_mean=0.45
if command -v magick > /dev/null 2>&1 && [ -r "$wallpaper" ]; then
  wallpaper_mean=$(magick "$wallpaper" -resize 1x1 -colorspace Gray -format '%[fx:mean]' info: 2> /dev/null || printf '0.45')
fi
if awk -v mean="$wallpaper_mean" 'BEGIN { exit !(mean > 0.65) }'; then
  lock_brightness=0.58
else
  lock_brightness=0.78
fi

fingerprint_enabled=0
if command -v fprintd-list > /dev/null 2>&1; then
  fingerprint_status=$(fprintd-list "$USER" 2> /dev/null || true)
  if grep -qE 'Device at|Using device' <<< "$fingerprint_status" \
      && grep -qE '^[[:space:]]*-[[:space:]]*#[0-9]+' <<< "$fingerprint_status"; then
    fingerprint_enabled=1
  fi
fi

theme=dark
if [ -r "$theme_file" ] && [ "$(tr -d '[:space:]' < "$theme_file")" = light ]; then
  theme=light
fi

# Keep the current wallpaper as the backdrop, then shift the overlay slightly
# warmer at night so the lock screen feels connected to the time of day.
tint_target="rgba(43, 48, 58, 0.78)"
tint_color="$tint_target"
case "$(date +%H)" in
  00|01|02|03|04|05) tint_color="rgba(20, 29, 43, 0.84)" ;;
  18|19|20|21|22|23) tint_color="rgba(52, 39, 43, 0.82)" ;;
esac

if [ "$theme" = light ]; then
  tint_target="rgba(232, 235, 239, 0.78)"
  case "$(date +%H)" in
    00|01|02|03|04|05) tint_color="rgba(220, 229, 242, 0.84)" ;;
    18|19|20|21|22|23) tint_color="rgba(242, 229, 232, 0.82)" ;;
    *) tint_color="$tint_target" ;;
  esac
fi

mkdir -p "$cache_dir"

render_config() {
  local color_args=()
  if [ "$theme" = light ]; then
    color_args=(
      -e 's/rgba(248, 249, 251,/rgba(32, 36, 42,/g'
      -e 's/rgba(183, 190, 201,/rgba(89, 97, 109,/g'
      -e 's/rgba(43, 48, 58,/rgba(232, 235, 239,/g'
      -e 's/rgba(51, 64, 77,/rgba(215, 220, 227,/g'
      -e 's/rgb(62, 89, 120)/rgb(201, 225, 247)/g'
      -e 's/rgb(140, 174, 216)/rgb(92, 148, 200)/g'
    )
  fi

  sed "${color_args[@]}" \
    -e "s/$tint_target/$tint_color/g" \
    -e "s/@PRIMARY_MONITOR@/$primary_monitor/g" \
    -e "s/@SIDE_MARGIN@/$side_margin/g" \
    -e "s/@NOTIFICATION_SIZE@/$notification_size/g" \
    -e "s/@NOTIFICATION_OFFSET@/$notification_offset/g" \
    -e "s/@LOCK_BRIGHTNESS@/$lock_brightness/g" \
    "$template" \
  | awk -v fingerprint="$fingerprint_enabled" '
      /# @FINGERPRINT_AUTH@/ {
        if (fingerprint) {
          print "auth {"
          print "  fingerprint {"
          print "    enabled = true"
          print "    ready_message = Touch fingerprint sensor to unlock"
          print "    present_message = Scanning fingerprint..."
          print "    retry_delay = 250"
          print "  }"
          print "}"
        }
        next
      }
      { print }
    '
}

render_config > "$config"

exec hyprlock --config "$config" "$@"
