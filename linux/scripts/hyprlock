#!/usr/bin/bash

set -Eeuo pipefail

dotfiles="$HOME/dotfiles"
template="$dotfiles/linux/config/hypr/hyprlock.conf"
theme_file="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/color-scheme"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
config="$cache_dir/hyprlock.conf"
primary_monitor=$(hyprctl monitors -j 2> /dev/null | jq -r '.[] | select(.focused) | .name' 2> /dev/null | head -n 1 || true)

theme=dark
if [ -r "$theme_file" ] && [ "$(tr -d '[:space:]' < "$theme_file")" = light ]; then
  theme=light
fi

# Keep the current wallpaper as the backdrop, then shift the overlay slightly
# warmer at night so the lock screen feels connected to the time of day.
tint_target="rgba(43, 48, 58, 0.78)"
tint_color="$tint_target"
case "$(date +%H)" in
  00|01|02|03|04|05) tint_color="rgba(20, 29, 43, 0.84)" ;;
  18|19|20|21|22|23) tint_color="rgba(52, 39, 43, 0.82)" ;;
esac

if [ "$theme" = light ]; then
  tint_target="rgba(232, 235, 239, 0.78)"
  case "$(date +%H)" in
    00|01|02|03|04|05) tint_color="rgba(220, 229, 242, 0.84)" ;;
    18|19|20|21|22|23) tint_color="rgba(242, 229, 232, 0.82)" ;;
    *) tint_color="$tint_target" ;;
  esac
fi

mkdir -p "$cache_dir"

if [ "$theme" = light ]; then
  sed \
    -e 's/rgba(248, 249, 251,/rgba(32, 36, 42,/g' \
    -e 's/rgba(183, 190, 201,/rgba(89, 97, 109,/g' \
    -e 's/rgba(43, 48, 58,/rgba(232, 235, 239,/g' \
    -e 's/rgba(51, 64, 77,/rgba(215, 220, 227,/g' \
    -e 's/rgb(62, 89, 120)/rgb(201, 225, 247)/g' \
    -e 's/rgb(140, 174, 216)/rgb(92, 148, 200)/g' \
    -e "s/$tint_target/$tint_color/g" \
    -e "s/@PRIMARY_MONITOR@/$primary_monitor/g" \
    "$template" > "$config"
else
  sed \
    -e "s/$tint_target/$tint_color/g" \
    -e "s/@PRIMARY_MONITOR@/$primary_monitor/g" \
    "$template" > "$config"
fi

exec hyprlock --config "$config" "$@"
