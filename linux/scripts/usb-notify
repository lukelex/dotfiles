#!/usr/bin/bash

set -Eeuo pipefail

source "$HOME/dotfiles/linux/variables.env"

action=""
devpath=""
devtype=""
model=""
vendor=""
interfaces=""
batch_started=0
batch_updated=0
now=0
partial_line=""
declare -a batch_actions=() batch_names=() batch_icons=() batch_tags=()

clock_ms() {
  local timestamp="${EPOCHREALTIME/./}"
  now=$((10#$timestamp / 1000))
}

flush_batch() {
  local count=${#batch_actions[@]}
  ((count > 0)) || return 0

  local summary body icon tag connected=0 disconnected=0 i
  icon="${batch_icons[0]}"
  tag="${batch_tags[0]}"
  body="${batch_names[0]}"
  if ((count == 1)); then
    if [ "${batch_actions[0]}" = add ]; then
      summary="USB device connected"
    else
      summary="USB device disconnected"
    fi
  else
    body=""
    icon="usb"
    tag="usb-batch"
    for ((i = 0; i < count; i++)); do
      if [ "${batch_actions[i]}" = add ]; then
        connected=$((connected + 1))
      else
        disconnected=$((disconnected + 1))
      fi
      if ((i < 5)); then
        body+="${body:+$'\n'}${batch_names[i]}"
        if [ "${batch_actions[i]}" = add ]; then
          body+=" (connected)"
        else
          body+=" (disconnected)"
        fi
      fi
    done
    if ((disconnected == 0)); then
      summary="$connected USB devices connected"
    elif ((connected == 0)); then
      summary="$disconnected USB devices disconnected"
      icon="unplug"
    else
      summary="USB: $connected connected, $disconnected disconnected"
    fi
    if ((count > 5)); then
      body+=$'\n'"… and $((count - 5)) more"
    fi
  fi

  notify-send -a "USB connections" \
    -i "$LUCIDE_PATH/$icon.svg" \
    -h "string:wired-tag:$tag" \
    -u low \
    -t 5000 \
    "$summary" "$body" || true
  batch_actions=() batch_names=() batch_icons=() batch_tags=()
}

flush_due() {
  ((${#batch_actions[@]} > 0)) || return 0
  clock_ms
  if ((now - batch_updated >= 1000 || now - batch_started >= 3000)); then
    flush_batch
  fi
}

reset_event() {
  action=""
  devpath=""
  devtype=""
  model=""
  vendor=""
  interfaces=""
}

notify_event() {
  [ "$devtype" = usb_device ] || return 0
  [ "$action" = add ] || [ "$action" = remove ] || return 0

  # Root hubs are USB devices too, but they are not user-connected peripherals.
  if [[ "$devpath" =~ /usb[0-9]+$ ]]; then
    return 0
  fi

  local name icon tag type
  model="${model//_/ }"
  vendor="${vendor//_/ }"
  name="${vendor:+$vendor }${model:-USB device}"
  tag="usb-${devpath//[^[:alnum:]]/-}"

  if [ "$action" = add ]; then
    icon="usb"
  else
    icon="unplug"
  fi

  # Use USB interface classes, not model-name guesses. Combined keyboard/mouse
  # receivers stay generic because they do not identify a single peripheral.
  type=""
  case "$interfaces" in
    *:030101:*030102:*|*:030102:*030101:*) ;;
    *:030102:*) type="Mouse"; icon="mouse" ;;
    *:030101:*) type="Keyboard"; icon="keyboard" ;;
    *:08????:*) type="Storage device"; icon="hard-drive" ;;
    *:0e????:*) type="Camera"; icon="camera" ;;
    *:07????:*) type="Printer"; icon="printer" ;;
    *:01????:*) type="Audio device"; icon="speaker" ;;
    *:09????:*) type="USB hub"; icon="usb" ;;
  esac

  printf 'usb-notify: %s %s\n' "$action" "$name" >&2
  flush_due
  clock_ms
  if ((${#batch_actions[@]} == 0)); then
    batch_started=$now
  fi
  batch_updated=$now
  batch_actions+=("$action")
  batch_names+=("${type:+$type: }$name")
  batch_icons+=("$icon")
  batch_tags+=("$tag")
}

# udevadm writes to a pipe here, so force line buffering for prompt notifications.
stdbuf --output=L udevadm monitor --udev --property --subsystem-match=usb |
  while true; do
    # Wake while udev is idle too, so the last event in a burst gets delivered.
    if IFS= read -r -t 0.2 line; then
      line="$partial_line$line"
      partial_line=""
    else
      status=$?
      if ((status > 128)); then
        partial_line+="$line"
        flush_due
        continue
      fi
      notify_event
      flush_batch
      break
    fi
    case "$line" in
      "UDEV "*)
        notify_event
        reset_event
        ;;
      ACTION=*) action="${line#ACTION=}" ;;
      DEVPATH=*) devpath="${line#DEVPATH=}" ;;
      DEVTYPE=*) devtype="${line#DEVTYPE=}" ;;
      ID_MODEL_FROM_DATABASE=*) model="${line#ID_MODEL_FROM_DATABASE=}" ;;
      ID_MODEL=*) [ -n "$model" ] || model="${line#ID_MODEL=}" ;;
      ID_VENDOR_FROM_DATABASE=*) vendor="${line#ID_VENDOR_FROM_DATABASE=}" ;;
      ID_VENDOR=*) [ -n "$vendor" ] || vendor="${line#ID_VENDOR=}" ;;
      ID_USB_INTERFACES=*) interfaces="${line#ID_USB_INTERFACES=}" ;;
      "")
        notify_event
        reset_event
        ;;
    esac
    flush_due
  done
