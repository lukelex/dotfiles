#!/usr/bin/bash

set -eu

source "$HOME/dotfiles/linux/variables.env"

info=$(sudo -n nordvpn status)
status=$(awk -F ': ' '/^Status:/{print $2; exit}' <<< "$info")
summary=$(grep -viE '^(Status|server|technology|protocol):' <<< "$info" || true)

notify-send -a System \
  -i "$LUCIDE_PATH/globe.svg" \
  -h string:wired-tag:system \
  "$status" "$summary" 2> /dev/null || true
