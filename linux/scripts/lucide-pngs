#!/usr/bin/bash
set -eu

## Rasterize the vendored Lucide SVGs into PNGs for eww.
## Eww's image widgets cannot load SVG, so we convert each needed icon from
## linux/config/lucide/svg into a 256x256 PNG under linux/config/lucide/png.
## The PNG dir is gitignored and regenerated by `eww prepare` / `install/icons`.

source "$HOME/dotfiles/linux/variables.env"

RASTERIZER="${RASTERIZER:-rsvg-convert}"

missing=0
require() { # svgname
  local png="$LUCIDE_PNG_PATH/$1.png"
  local svg="$LUCIDE_PATH/$1.svg"
  if [[ ! -f "$svg" ]]; then
    echo "lucide: missing vendored svg: $1" >&2
    missing=1
    return
  fi
  if [[ "$svg" -nt "$png" || ! -f "$png" ]]; then
    "$RASTERIZER" -w 256 -h 256 "$svg" -o "$png"
  fi
}

mkdir -p "$LUCIDE_PNG_PATH"

## All icons referenced by eww widgets and eww scripts.
for icon in \
  monitor sun sun-medium sun-dim moon moon-star volume volume-1 volume-2 \
  volume-x volume-off mic mic-off mic-audio-lines mic-vocal battery \
  battery-full battery-low battery-medium battery-warning battery-charging \
  battery-plus cloud-lightning cloud-sun globe clock alarm-clock bluetooth \
  bluetooth-connected bluetooth-off lock log-out refresh-cw power power-off \
  circle-power printer camera webcam face-slightly-smiling chevrons-down-up \
  circle-arrow-down circle-arrow-up scan-line keyboard laptop memory-stick \
  microchip hard-drive cpu gauge thermometer sliders settings cog search \
  headphones headset speaker box boxes message-square user trash arrow-right \
  arrow-up arrow-down arrow-left-right arrow-up-down ethernet-port network \
  router signal nfc wifi plane send clapperboard disc bell key key-round \
  circle-check expand monitor-off copy message-square-quote
do
  require "$icon"
done

exit "$missing"
