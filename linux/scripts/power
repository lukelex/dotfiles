#!/usr/bin/bash
set -eu

## Keyboard driver for the centered eww power menu.
## Traverses the 5 actions with a cursor kept in the `power_cursor` eww variable.

ACTIONS=(lock suspend logout reboot shutdown)

cursor() {
  eww get power_cursor 2>/dev/null || echo 0
}

n_actions() {
  echo "${#ACTIONS[@]}"
}

move() {
  local n cur
  n=$(n_actions)
  cur=$(cursor)
  case ${1:-} in
    next) cur=$((cur + 1)) ;;
    prev) cur=$((cur - 1)) ;;
    *) return 1 ;;
  esac
  cur=$((cur % n + n))
  cur=$((cur % n))
  eww update "power_cursor=$cur"
}

run_action() {
  local name=$1
  for a in "${ACTIONS[@]}"; do
    [[ "$name" == "$a" ]] || continue
    u_exit "$name" &
    u_eww close &
    return 0
  done
  return 1
}

select_action() {
  run_action "${ACTIONS[$(cursor)]}"
}

case ${1:-} in
  open)   eww update "power_cursor=0" && u_eww toggle power ;;
  next)   move next ;;
  prev)   move prev ;;
  select) select_action ;;
  run)    shift; run_action "${1:-}" ;;
  *)      exit 1 ;;
esac