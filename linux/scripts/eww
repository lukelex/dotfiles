#!/usr/bin/bash

source "$HOME/dotfiles/linux/variables.env"

## Regenerate eww's icon paths from $FONT_AWESOME_PATH.
## Eww's .yuck cannot expand environment variables and cannot load SVG,
## so we point it at the PNG tree that lives next to $FONT_AWESOME_PATH.
prepare() {
  local fa_root
  fa_root=$(dirname "$FONT_AWESOME_PATH")

  cat > "$DOT_CONFIG/eww/paths.yuck" <<YUCK
(defvar ICONS_PATH "$fa_root/pngs/solid")
(defvar BRANDS_ICONS_PATH "$fa_root/pngs/brands")
YUCK
}

case $1 in
  prepare)
    prepare
    exit 0
    ;;
esac

prepare

## Run eww daemon if not running already
if [[ ! $(pidof eww) ]]; then
  eww daemon
  sleep 1
fi

toggle() {
  window=$1
  open=$(eww active-windows | grep ": $window$")
  eww close-all

  if [[ -z "$open" ]]; then
    eww open "$window"
  fi
}

case $1 in
  toggle) toggle "$2" ;;
  close) eww close-all ;;
esac
