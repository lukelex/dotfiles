#!/usr/bin/bash

source "$HOME/dotfiles/linux/variables.env"

## Regenerate eww's icon paths from $LUCIDE_PNG_PATH.
## Eww's .yuck cannot expand environment variables and cannot load SVG,
## so we rasterize the vendored Lucide SVGs to PNGs and point eww at them.
prepare() {
  "$DOTFILES/linux/scripts/lucide-pngs"

  cat > "$DOT_CONFIG/eww/paths.yuck" <<YUCK
(defvar ICONS_PATH "$LUCIDE_PNG_PATH")
(defvar BRANDS_ICONS_PATH "$LUCIDE_PNG_PATH")
YUCK
}

case $1 in
  prepare)
    prepare
    exit 0
    ;;
esac

prepare

## Run eww daemon if not running already
if [[ ! $(pidof eww) ]]; then
  eww daemon
  sleep 1
fi

toggle() {
  window=$1
  open=$(eww active-windows | grep ": $window$")
  eww close-all

  if [[ -z "$open" ]]; then
    eww open "$window"
  fi
}

case $1 in
  toggle) toggle "$2" ;;
  close) eww close-all ;;
esac
