#!/usr/bin/bash

set -Eeuo pipefail

usage() {
  printf 'Usage: %s {battery|network|vpn|audio|dnd|media|privacy|security|weather}\n' "${0##*/}" >&2
  exit 2
}

battery() {
  local device details state percentage time

  device=$(upower -e 2>/dev/null | grep -m 1 'BAT' || true)
  [ -n "$device" ] || return 0
  details=$(upower -i "$device" 2>/dev/null || true)
  state=$(awk '/^[[:space:]]*state:/{print $2; exit}' <<< "$details")
  percentage=$(awk '/^[[:space:]]*percentage:/{print $2; exit}' <<< "$details")
  time=$(awk '/^[[:space:]]*time to (empty|full):/{print $4 " " $5; exit}' <<< "$details")

  case "$state" in
    charging) printf '󰂄 %s%s\n' "${percentage:-Battery}" "${time:+ · full in $time}" ;;
    discharging) printf '󰁹 %s%s\n' "${percentage:-Battery}" "${time:+ · $time left}" ;;
    fully-charged) printf '󰁹 %s · full\n' "${percentage:-100%}" ;;
    *) printf '󰁹 %s\n' "${percentage:-Battery}" ;;
  esac
}

network() {
  local connection type

  command -v nmcli > /dev/null 2>&1 || return 0
  IFS=: read -r connection type < <(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null | head -n 1 || true)
  [ -n "${connection:-}" ] || { printf '󰤭 Offline\n'; return; }

  case "$type" in
    wifi) printf '󰤨 %s\n' "$connection" ;;
    ethernet) printf '󰈀 %s\n' "$connection" ;;
    *) printf '󰛳 %s\n' "$connection" ;;
  esac
}

vpn() {
  command -v nordvpn > /dev/null 2>&1 || return 0

  if nordvpn status 2>/dev/null | grep -q '^Status: Connected'; then
    printf '󰦝 VPN connected\n'
  else
    printf '󰦞 VPN off\n'
  fi
}

audio() {
  local volume muted

  command -v wpctl > /dev/null 2>&1 || return 0
  volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)
  [ -n "$volume" ] || return 0
  muted=$(grep -o '\[MUTED\]' <<< "$volume" || true)
  volume=$(awk '{printf "%d", $2 * 100}' <<< "$volume")
  if [ -n "$muted" ]; then
    printf '󰝟 Muted\n'
  else
    printf '󰕾 %s%%\n' "$volume"
  fi
}

dnd() {
  local state_file="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/notifications.conf"

  if [ -r "$state_file" ] && grep -q '^doNotDisturb=true$' "$state_file"; then
    printf '󰂛 Do Not Disturb · notifications muted\n'
  fi
}

media() {
  local status artist title prefix

  command -v playerctl > /dev/null 2>&1 || return 0
  status=$(playerctl status 2> /dev/null || true)
  title=$(playerctl metadata --format '{{title}}' 2> /dev/null || true)
  [ -n "$title" ] || return 0
  artist=$(playerctl metadata --format '{{artist}}' 2> /dev/null || true)
  prefix='󰎆'
  [ "$status" = Paused ] && prefix='󰏤'
  printf '%s %s%s\n' "$prefix" "$title" "${artist:+ · $artist}"
}

privacy() {
  local indicators=()

  if command -v wpctl > /dev/null 2>&1 \
      && wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2> /dev/null | grep -q 'node.state = "running"'; then
    indicators+=("󰍬 Microphone active")
  fi

  if command -v fuser > /dev/null 2>&1 && compgen -G '/dev/video*' > /dev/null \
      && fuser /dev/video* > /dev/null 2>&1; then
    indicators+=("󰄀 Camera active")
  fi

  (IFS=' · '; printf '%s\n' "${indicators[*]}")
}

security() {
  local attempts last

  command -v faillock > /dev/null 2>&1 || return 0
  read -r attempts last < <(
    faillock --user "$USER" 2> /dev/null \
      | awk '$1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ { count++; if (!last) last = $1 " " $2 } END { print count + 0, last }'
  )
  [ "${attempts:-0}" -gt 0 ] || return 0
  if [ -n "${last:-}" ]; then
    printf '󰌁 %s failed unlock%s · last %s\n' "$attempts" "$([ "$attempts" -eq 1 ] || printf s)" "$last"
  else
    printf '󰌁 %s failed unlock%s\n' "$attempts" "$([ "$attempts" -eq 1 ] || printf s)"
  fi
}

weather() {
  local current_file="${XDG_CACHE_HOME:-$HOME/.cache}/weather/current.json"
  local description temperature

  [ -r "$current_file" ] || return 0
  description=$(jq -r '.weather[0].description // empty' "$current_file" 2> /dev/null || true)
  temperature=$(jq -r '.main.temp // empty' "$current_file" 2> /dev/null || true)
  [ -n "$description" ] && [ -n "$temperature" ] || return 0
  temperature=$(awk -v value="$temperature" 'BEGIN { printf "%.0f", value }')
  printf '󰖐 %s°C · %s\n' "$temperature" "$description"
}

case "${1:-}" in
  battery) battery ;;
  network) network ;;
  vpn) vpn ;;
  audio) audio ;;
  dnd) dnd ;;
  media) media ;;
  privacy) privacy ;;
  security) security ;;
  weather) weather ;;
  *) usage ;;
esac
