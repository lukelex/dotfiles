#!/usr/bin/bash

set -u

# The supervisor starts this sidecar only after native lock readiness. Legacy
# command callers bypass dimming instead of putting hardware I/O before locking.
if [[ ${1:-} != --watch ]]; then
  exec "$@"
fi
locker_pid=$2
backlight_before_lock=
external_brightness=()

restore_brightness() {
  local entry
  if [[ -n "$backlight_before_lock" ]]; then
    timeout -k 0.2 1 light -S "$backlight_before_lock" 2> /dev/null || true
  fi
  # One bounded restore per display; DDC fades can stall on broken I2C buses.
  for entry in "${external_brightness[@]}"; do
    timeout -k 0.2 1 ddcutil --bus="${entry%%:*}" setvcp 10 "${entry#*:}" > /dev/null 2>&1 || true
  done
}
trap restore_brightness EXIT
trap 'exit 0' TERM INT

dotfiles="$HOME/dotfiles"
lock_brightness=$(timeout -k 0.2 1 python3 "$dotfiles/linux/config/system-settings/settings.py" get display.lockBrightness 2> /dev/null || printf '5')
if [[ ! $lock_brightness =~ ^[0-9]+$ ]] || (( lock_brightness > 100 )); then
  lock_brightness=5
fi

if command -v light > /dev/null 2>&1; then
  current=$(timeout -k 0.2 1 light -G 2> /dev/null | cut -f1 -d . || true)
  if [[ $current =~ ^[0-9]+$ ]] && (( current > lock_brightness )); then
    backlight_before_lock=$current
    timeout -k 0.2 1 light -S "$lock_brightness" 2> /dev/null || true
  fi
fi

if command -v ddcutil > /dev/null 2>&1; then
  while IFS= read -r bus_path; do
    [[ $bus_path =~ /dev/i2c-([0-9]+) ]] || continue
    bus=${BASH_REMATCH[1]}
    kill -0 "$locker_pid" 2> /dev/null || break
    current=$(timeout -k 0.2 1 ddcutil --bus="$bus" getvcp 10 2> /dev/null \
      | grep -oP 'current\s+value\s*=\s*\K\d+' | head -n 1 || true)
    if [[ $current =~ ^[0-9]+$ ]] && (( current > lock_brightness )); then
      external_brightness+=("$bus:$current")
      timeout -k 0.2 1 ddcutil --bus="$bus" setvcp 10 "$lock_brightness" > /dev/null 2>&1 || true
    fi
  done < <(timeout -k 0.2 1 "$dotfiles/linux/scripts/monitors" brightness list 2> /dev/null || true)
fi

while kill -0 "$locker_pid" 2> /dev/null; do sleep 0.2; done
