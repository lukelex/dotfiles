#!/usr/bin/bash
set -eu

source "$HOME/dotfiles/linux/variables.env"

## External (DDC/CI) display brightness control.
## Enumerates every real display ddcutil can reach and reads/writes VCP code
## 10 (brightness) on each. No root needed: ddcutil ships an udev rule that
## grants the i2c group read/write access to the DDC buses.

FEATURE=10
FEATURE_NAME="Brightness"

## Bus paths of every display that answered DDC/CI (the laptop panel shows up
## as "Invalid display" and is skipped here on purpose).
displays() {
  local current=""
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in
      "Display "*) current=valid ;;
      "Invalid display"*) current=invalid ;;
      "I2C bus:"*)
        if [[ "$current" == valid ]]; then
          echo "$line" | grep -o '/dev/i2c-[0-9]\+'
        fi
        ;;
    esac
  done < <(ddcutil detect 2>/dev/null)
}

getvcp() { # bus
  local bus=${1##*-}
  ddcutil --bus="$bus" getvcp "$FEATURE" 2>/dev/null \
    | grep -oP 'current\s+value\s*=\s*\K\d+' || true
}

setvcp() { # bus value
  local bus=${1##*-}
  [[ "$bus" =~ ^[0-9]+$ ]] || return 1
  ddcutil --bus="$bus" setvcp "$FEATURE" "$2" &> /dev/null
}

current_average() {
  local buses total=0 count=0
  buses=$(displays)
  [[ -n "$buses" ]] || { echo -1; return; }
  while IFS= read -r bus; do
    [[ -n "$bus" ]] || continue
    local val
    val=$(getvcp "$bus")
    [[ -n "$val" ]] || continue
    total=$(( total + val ))
    count=$(( count + 1 ))
  done <<< "$buses"
  if (( count > 0 )); then
    echo "$(( total / count ))"
  else
    echo -1
  fi
}

show() {
  local value=$1
  notify-send -a System \
    -i "$LUCIDE_PATH/monitor.svg" \
    -h int:value:"$value" \
    -h string:wired-tag:system \
    "$FEATURE_NAME" 2> /dev/null || true
}

set_all_unlocked() { # value
  local bus applied=false
  while IFS= read -r bus; do
    [[ -n "$bus" ]] || continue
    if setvcp "$bus" "$1"; then
      applied=true
    fi
  done <<< "$(displays)"
  [[ "$applied" == true ]]
}

set_all() { # value [quiet]
  local value=$1 quiet=${2:-}
  value=$(clamp_value "$value") || return 1
  if (
    flock -n 9 || exit 75
    set_all_unlocked "$value"
  ) 9> "${XDG_RUNTIME_DIR:-/tmp}/u_monitors_set.lock"; then
    if [[ "$quiet" != quiet ]]; then
      show "$value"
    fi
  fi
}

clamp_value() { # value -> 0..100
  local v=$1
  [[ "$v" =~ ^-?[0-9]+$ ]] || return 1
  (( v < 0 )) && v=0
  (( v > 100 )) && v=100
  echo "$v"
}

usage() {
  echo "Usage: u_monitors brightness {if|get|set <0-100>|inc|dec|reset|list|xrandr}" >&2
}

case ${1:-} in
  brightness|display)
    ;;
  *)
    usage
    exit 2
    ;;
esac

case ${2:-} in
  if)   echo "$([[ -n "$(displays)" ]] && echo true || echo false)" ;;
  get)  current_average ;;
  set)
    if [[ $# -lt 3 ]]; then
      usage
      exit 2
    fi
    set_all "$3"
    ;;
  inc)  set_all "$(( $(current_average) + 5 ))" ;;
  dec)  set_all "$(( $(current_average) - 5 ))" ;;
  reset) set_all 0 ;;
  list)
    if [[ -n "$(displays)" ]]; then displays; else echo "none"; fi
    ;;
  xrandr)
    xrandr 2>/dev/null | grep -E '\bconnected' || true
    ;;
  *)
    usage
    exit 2
    ;;
esac
