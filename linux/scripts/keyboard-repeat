#!/usr/bin/bash

set -Eeuo pipefail

: "${DISPLAY:?keyboard-repeat requires an X11 session}"
runtime_dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}"
session="${I3SOCK:-$DISPLAY}"
mkdir -p "$runtime_dir"
exec 9>"$runtime_dir/dotfiles-keyboard-repeat-${session//[^a-zA-Z0-9]/_}.lock"
flock -n 9 || exit 0

# X11 input resets can undo the rate after login, unlock, resume, or hotplug.
# This replaces the five-second correction previously supplied by Polybar.
while true; do
  if settings=$(python3 "$(dirname "$(readlink -f "$0")")/../config/system-settings/settings.py" get input); then
    xset r rate "$(jq -r '.repeatDelay' <<< "$settings")" "$(jq -r '.repeatRate' <<< "$settings")" || break
  fi
  sleep 5
done
