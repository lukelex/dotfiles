#!/usr/bin/bash

set -euo pipefail

DISPLAY_RE='([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)'
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
CACHE_FOLDER="${XDG_CACHE_HOME:-$HOME/.cache}/i3lock/img"
DEFAULT_IMAGE="$HOME/wallpaper.png"

mkdir -p "$CACHE_FOLDER"

arg_image=""
dry_run=false
lock_args=()
while getopts ":i:a:d:" opt; do
  case $opt in
    i) arg_image=$OPTARG ;;
    a) read -r -a lock_args <<< "$OPTARG" ;;
    d) arg_image=$OPTARG; dry_run=true ;;
    \?) echo "Invalid option -$OPTARG" >&2; exit 2 ;;
  esac
done

if [[ -z "$arg_image" ]]; then
  if [[ -r "$DEFAULT_IMAGE" ]]; then
    arg_image=$DEFAULT_IMAGE
  else
    arg_image="$SCRIPT_DIR/img/background.png"
  fi
fi

if (( ${#lock_args[@]} == 0 )); then
  lock_args=(--tiling --ignore-empty-password --show-failed-attempts --nofork)
fi

lock_black() {
  exec i3lock --color 000000 "${lock_args[@]}"
}

build_image() {
  local screen_config md5_background md5_screens output_img line
  local screen_width screen_height screen_x screen_y cache_img
  local output_width=0 output_height=0 screens=0
  local -a compose_args

  [[ -r "$arg_image" ]] || return 1
  screen_config=$(xrandr --query) || return 1
  md5_background=$(md5sum "$arg_image" | cut -c 1-10) || return 1
  md5_screens=$(md5sum <<< "$screen_config" | cut -c 1-32) || return 1
  output_img="$CACHE_FOLDER/$md5_screens.$md5_background.png"

  if [[ -s "$output_img" ]]; then
    printf '%s\n' "$output_img"
    return 0
  fi

  while IFS= read -r line; do
    if [[ $line =~ $DISPLAY_RE ]]; then
      screen_width=${BASH_REMATCH[1]}
      screen_height=${BASH_REMATCH[2]}
      screen_x=${BASH_REMATCH[3]}
      screen_y=${BASH_REMATCH[4]}
      cache_img="$CACHE_FOLDER/${screen_width}x${screen_height}.$md5_background.png"

      if [[ ! -s "$cache_img" ]]; then
        convert "$arg_image" -resize "${screen_width}x${screen_height}^" \
          -gravity Center -crop "${screen_width}x${screen_height}+0+0" \
          +repage "$cache_img" || return 1
      fi

      if (( output_width < screen_width + screen_x )); then
        output_width=$(( screen_width + screen_x ))
      fi
      if (( output_height < screen_height + screen_y )); then
        output_height=$(( screen_height + screen_y ))
      fi
      compose_args+=(-colorspace sRGB -type TrueColor "$cache_img" -geometry "+${screen_x}+${screen_y}" -composite)
      (( screens += 1 ))
    fi
  done <<< "$screen_config"

  (( screens > 0 )) || return 1
  convert -size "${output_width}x${output_height}" xc:black "$output_img" || return 1
  convert "$output_img" "${compose_args[@]}" "$output_img" || return 1
  [[ -s "$output_img" ]] || return 1
  printf '%s\n' "$output_img"
}

if output_img=$(build_image); then
  if [[ "$dry_run" == true ]]; then
    exit 0
  fi
  exec i3lock --image "$output_img" "${lock_args[@]}"
fi

lock_black
