#!/usr/bin/bash

set -Eeuo pipefail

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
cache_file="$cache_dir/lock-battery-ring.svg"
mkdir -p "$cache_dir"

device=$(upower -e 2>/dev/null | grep -m 1 'BAT' || true)
percentage=0
state=""
if [[ -n $device ]]; then
  details=$(upower -i "$device" 2>/dev/null || true)
  percentage=$(awk '/^[[:space:]]*percentage:/{gsub(/%/, "", $2); print $2; exit}' <<< "$details")
  state=$(awk '/^[[:space:]]*state:/{print $2; exit}' <<< "$details")
fi

if [[ -z $device || ! $percentage =~ ^[0-9]+$ ]]; then
  printf '<svg xmlns="http://www.w3.org/2000/svg" width="1" height="1"/>' > "$cache_file"
else
  percentage=$((percentage > 100 ? 100 : percentage))
  color="#8CAED8"
  [[ $percentage -le 20 ]] && color="#DA4939"
  [[ $state == charging ]] && color="#9BCB9B"
  circumference=326.73
  dash=$(awk -v value="$percentage" -v total="$circumference" 'BEGIN { printf "%.2f", value * total / 100 }')
  temporary=$(mktemp "$cache_file.XXXXXX")
  trap 'rm -f "$temporary"' EXIT
  cat > "$temporary" <<EOF
<svg xmlns="http://www.w3.org/2000/svg" width="144" height="144" viewBox="0 0 144 144">
  <circle cx="72" cy="72" r="52" fill="#2B303A" fill-opacity=".88" stroke="#33404D" stroke-width="8"/>
  <circle cx="72" cy="72" r="52" fill="none" stroke="$color" stroke-width="8" stroke-linecap="round" stroke-dasharray="$dash $circumference" transform="rotate(-90 72 72)"/>
  <text x="72" y="78" text-anchor="middle" fill="#F8F9FB" font-family="Hack Nerd Font Mono, monospace" font-size="24">$percentage%</text>
  <text x="72" y="98" text-anchor="middle" fill="#B7BEC9" font-family="Hack Nerd Font Mono, monospace" font-size="11">$([[ $state == charging ]] && printf charging || printf battery)</text>
</svg>
EOF
  mv -f "$temporary" "$cache_file"
fi

printf '%s\n' "$cache_file"
