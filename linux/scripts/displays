#!/usr/bin/bash
set -eu

## Display layouts from autorandr.
## Serves the eww "Displays" widget with the saved profiles and the built-in
## virtual layouts (mirror / horizontal / vertical / ...), each tagged with
## whether the displays it needs are currently available.

AUTORANDR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autorandr"

## Names of every saved profile (directories under $AUTORANDR_DIR).
profiles() {
  for d in "$AUTORANDR_DIR"/*/; do
    [[ -d "$d" ]] || continue
    basename "$d"
  done
}

## Currently connected outputs, one per line.
connected() {
  xrandr --query 2>/dev/null | awk '/ connected / {print $1}'
}

## Outputs a profile actually turns on (everything except lines marked `off`).
profile_outputs() {
  awk '
    /^output / {
      if (out != "" && on) used[out] = 1
      out = $2; on = 0; next
    }
    /^off[[:space:]]*$/ { on = 0; next }
    { if (out != "") on = 1 }
    END {
      if (out != "" && on) used[out] = 1
      for (o in used) print o
    }
  ' "$AUTORANDR_DIR/$1/config"
}

list() {
  local current conn name o avail
  current=$(autorandr --current 2>/dev/null || true)
  conn=$(connected)

  for name in $(profiles | sort); do
    avail=true
    for o in $(profile_outputs "$name"); do
      if ! grep -qx "$o" <<< "$conn"; then
        avail=false
      fi
    done
    jq -cn --arg name "$name" \
          --argjson available "$avail" \
          --arg current "$current" \
      '{name: $name, available: $available, active: ($name == $current)}'
  done | jq -s .
}

## Which virtual layout (if any) matches the current xrandr geometry.
## off: every display off | common: all outputs cloned to one position
## horizontal: side by side | vertical: stacked
current_layout() {
  local g n
  local -a geoms=()
  mapfile -t geoms < <(xrandr --query | awk '/ connected / {
    for (i = 1; i <= NF; i++)
      if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) print $i
  }')

  n=${#geoms[@]}
  (( n == 0 )) && { echo "off"; return; }
  (( n == 1 )) && { echo ""; return; }

  local first="${geoms[0]}" mirror=1
  for g in "${geoms[@]}"; do
    [[ "$g" == "$first" ]] || mirror=0
  done
  (( mirror )) && { echo "common"; return; }

  local -a xs=() ys=() ws=() hs=()
  for g in "${geoms[@]}"; do
    [[ "$g" =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]]
    ws+=("${BASH_REMATCH[1]}")
    hs+=("${BASH_REMATCH[2]}")
    xs+=("${BASH_REMATCH[3]}")
    ys+=("${BASH_REMATCH[4]}")
  done

  local i y0=1 x0=1 yprev xprev
  yprev=${ys[0]}; xprev=${xs[0]}
  for (( i = 1; i < n; i++ )); do
    (( ys[i] == yprev )) || y0=0
    (( xs[i] == xprev )) || x0=0
    yprev=${ys[i]}; xprev=${xs[i]}
  done
  (( y0 )) && { echo "horizontal"; return; }
  (( x0 )) && { echo "vertical"; return; }
  echo ""
}

## Virtual layouts from autorandr and whether enough outputs are connected.
## Emits a 3x2 grid of tiles as an array of rows (each row <= 3 tiles), which
## lets the eww "for" loop build the matrix without array indexing.
layouts() {
  local conn n avail current name label icon min
  conn=$(connected)
  n=$(wc -l <<< "$conn" | tr -d ' ')
  current=$(current_layout)

  local rows=()
  local row=() count=0
  while IFS=$'\t' read -r name label icon min; do
    if (( n >= min )); then avail=true; else avail=false; fi
    row+=("$(jq -cn --arg name "$name" \
                   --arg label "$label" \
                   --arg icon "$icon" \
                   --arg current "$current" \
                   --argjson available "$avail" \
      '{name: $name, label: $label, icon: $icon,
        available: $available, active: ($name == $current)}')")
    count=$((count + 1))
    if (( count == 3 )); then
      rows+=("$(printf '[%s]' "$(IFS=,; echo "${row[*]}")")")
      row=(); count=0
    fi
  done <<'EOF'
off	Off	monitor-off	2
common	Mirror	copy	2
clone-largest	Clone largest	expand	2
horizontal	Horizontal	arrow-left-right	2
vertical	Vertical	arrow-up-down	2
EOF
  if (( count > 0 )); then
    rows+=("$(printf '[%s]' "$(IFS=,; echo "${row[*]}")")")
  fi
  printf '[%s]\n' "$(IFS=,; echo "${rows[*]}")"
}

apply() {
  autorandr --load "$2" &
}

case $1 in
  list)    list ;;
  layouts) layouts ;;
  load)    apply "$@" ;;
  *)       exit 1 ;;
esac