#!/usr/bin/bash

set -eu

helper="$(dirname "$(readlink -f "$0")")/../config/system-settings/wallpaper.py"

case $1 in
  load)
    exec python3 "$helper" restore ;;
  update|change)
    exec python3 "$helper" choose "$2" ;;
  random)
    exec python3 "$helper" random "${2:-}" ;;
  startup)
    exec python3 "$helper" startup ;;
  *) exit 2 ;;
esac
