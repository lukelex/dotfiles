#!/usr/bin/bash

function reset_ui {
  # Cleanup IPC must not delay locking while the compositor is suspending.
  timeout -k 0.2 1 u_music pause &> /dev/null &
  timeout -k 0.2 1 qs -p "$HOME/dotfiles/linux/config/quickshell/shell.qml" ipc call notifications clearVisible &> /dev/null &
}

case "$1" in
  lock)
    # The client retains any xss-lock delay inhibitor until real readiness.
    exec python3 "$HOME/dotfiles/linux/config/system-settings/session-lock.py" client ;;
  logout)
    case "$XDG_SESSION_DESKTOP" in
      i3|i3wm) i3-msg exit ;;
      Hyprland) hyprctl dispatch exit 1 ;;
      *) loginctl terminate-session "$(loginctl session-status | awk 'NR==1{print $1}')" ;;
    esac ;;
  sleep|suspend)
    reset_ui
    "$HOME/dotfiles/linux/scripts/lock-before-sleep" || exit 1
    exec systemctl suspend ;;
  hibernate)
    reset_ui
    "$HOME/dotfiles/linux/scripts/lock-before-sleep" || exit 1
    exec systemctl hibernate ;;
  reboot|reset)
    systemctl reboot ;;
  shutdown|poweroff)
    systemctl poweroff ;;
  *)
    echo "== ! exit: missing or invalid argument ! =="
    echo "Try again with: lock | logout | suspend | hibernate | reboot | shutdown"
    exit 2 ;;
esac

exit 0
