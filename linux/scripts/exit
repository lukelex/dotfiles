#!/usr/bin/bash

function reset_ui {
  # Cleanup IPC must not delay locking while the compositor is suspending.
  u_music pause 2&> /dev/null &
  qs -p "$HOME/dotfiles/linux/config/quickshell/shell.qml" ipc call notifications clearVisible 2&> /dev/null &
}

case "$1" in
  lock)
    reset_ui
    session_type="${XDG_SESSION_TYPE:-}"
    if [[ -z "$session_type" ]]; then
      if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        session_type=wayland
      elif [[ -n "${DISPLAY:-}" ]]; then
        session_type=x11
      fi
    fi
    case "$session_type" in
      x11) u_blurlock ;;
      # Use the repository path directly. A stale, removed u_hyprlock symlink
      # can still be returned by a shell command hash, causing a failed lock.
      wayland) exec "$HOME/dotfiles/linux/scripts/hyprlock" ;; # Hyprland rejects duplicate session locks.
    esac ;;
  logout)
    case "$XDG_SESSION_DESKTOP" in
      i3|i3wm) i3-msg exit ;;
      Hyprland) hyprctl dispatch exit 1 ;;
      *) loginctl terminate-session "$(loginctl session-status | awk 'NR==1{print $1}')" ;;
    esac ;;
  sleep|suspend)
    reset_ui
    $0 lock &
    systemctl suspend ;;
  hibernate)
    reset_ui && systemctl hibernate ;;
  reboot|reset)
    systemctl reboot ;;
  shutdown|poweroff)
    systemctl poweroff ;;
  *)
    echo "== ! exit: missing or invalid argument ! =="
    echo "Try again with: lock | logout | suspend | hibernate | reboot | shutdown"
    exit 2 ;;
esac

exit 0
