#!/usr/bin/bash

set -u

dim="#808080"

wifi=$(nmcli -t -f DEVICE,TYPE,STATE dev status | awk -F: '$2 == "wifi" && $3 == "connected" { print $1; exit }')
bt=$(bluetoothctl show 2>/dev/null | awk '/Powered:/ { print $2 }')
eth=$(nmcli -t dev status | awk -F: '$2 == "ethernet" && $1 !~ /^veth/ && $1 !~ /^br-/ && $1 != "docker0" && $3 == "connected" { print $1; exit }')

[[ -n "$wifi" ]] && wifi_icon=" " || wifi_icon="%{F${dim}}%{F-} "
[[ "$bt" == "yes" ]] && bt_icon=" " || bt_icon="%{F${dim}}%{F-} "
eth_icon=""
[[ -n "$eth" ]] && eth_icon=" "

icons="${wifi_icon}${bt_icon}${eth_icon}"
icons=${icons% }

echo "%{A1:u_eww toggle connections &:}${icons}%{A}"