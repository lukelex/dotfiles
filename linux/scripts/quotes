#!/usr/bin/bash

set -euo pipefail

umask 077
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/quotes"
DATE=$(date -u +%Y-%m-%d)
CACHE_FILE="$CACHE_DIR/$DATE"
LANGUAGE='en'
QUOTES_URL="https://quotes.rest/qod.json?category=inspire&language=$LANGUAGE"

mkdir -p "$CACHE_DIR"

get_quote() {
  local response quote temp_file

  if [[ ! -s "$CACHE_FILE" ]]; then
    response=$(curl --fail --silent --show-error --connect-timeout 5 --max-time 10 \
      -H "Authorization: Bearer $QUOTES_API_KEY" "$QUOTES_URL")
    quote=$(jq -er '.contents.quotes[0].quote' <<< "$response")

    temp_file=$(mktemp "$CACHE_DIR/$DATE.XXXXXX")
    printf '%s\n' "$quote" > "$temp_file"
    mv -f "$temp_file" "$CACHE_FILE"
  fi

  cat "$CACHE_FILE"
}

case ${1:-} in
  get) get_quote ;;
esac
