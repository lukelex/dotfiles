#!/usr/bin/bash

set -Eeuo pipefail

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dotfiles="$(cd "$install_dir/../.." && pwd)"
# shellcheck disable=SC1091
source "$install_dir/dotpkg-release.env"

if [ "${1:-}" != --path ] || [ "$#" -ne 1 ]; then
  printf 'Usage: %s --path\n' "$0" >&2
  exit 2
fi

case "$(uname -m)" in
  x86_64)
    architecture=amd64
    expected="$DOTPKG_SHA256_AMD64"
    ;;
  aarch64|arm64)
    architecture=arm64
    expected="$DOTPKG_SHA256_ARM64"
    ;;
  *)
    printf 'Unsupported dotpkg architecture: %s\n' "$(uname -m)" >&2
    exit 2
    ;;
esac

vendor_dir="$dotfiles/linux/vendor/dotpkg/$DOTPKG_VERSION"
binary="$vendor_dir/dotpkg-linux-$architecture"
mkdir -p "$vendor_dir"

if [ ! -f "$binary" ]; then
  command -v curl >/dev/null || { printf 'curl is required to download dotpkg\n' >&2; exit 2; }
  temporary="$binary.$$"
  trap 'rm -f "$temporary"' EXIT
  curl --fail --location --silent --show-error \
    "https://github.com/lukelex/dotpkg/releases/download/$DOTPKG_VERSION/dotpkg-linux-$architecture" \
    --output "$temporary"
  printf '%s  %s\n' "$expected" "$temporary" | sha256sum --check --status
  chmod 0755 "$temporary"
  mv "$temporary" "$binary"
  trap - EXIT
fi

printf '%s\n' "$expected  $binary" | sha256sum --check --status

# dotpkg owns the user-facing manifest and state locations. Seed the new
# per-user manifest from this repository once, and migrate the previous shared
# state without overwriting an existing user configuration.
dotpkg_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
dotpkg_config_dir="$dotpkg_config_home/dotpkg"
dotpkg_manifest="$dotpkg_config_dir/package.yaml"
dotpkg_state="$dotpkg_config_dir/state.yaml"
legacy_state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/install/state.yaml"
manifest_missing=0
state_missing=0
[ -f "$dotpkg_manifest" ] || manifest_missing=1
[ -f "$dotpkg_state" ] || state_missing=1

if [ "$manifest_missing" -eq 1 ] || [ "$state_missing" -eq 1 ]; then
  "$binary" init >/dev/null
fi
if [ "$manifest_missing" -eq 1 ]; then
  cp "$dotfiles/linux/packages.yaml" "$dotpkg_manifest"
  chmod 0600 "$dotpkg_manifest"
fi
if [ "$state_missing" -eq 1 ] && [ -f "$legacy_state" ]; then
  cp "$legacy_state" "$dotpkg_state"
  chmod 0600 "$dotpkg_state"
fi

# Expose the pinned dotpkg binary on the user's PATH.
user_bin="$HOME/.local/bin"
mkdir -p "$user_bin"
link="$user_bin/dotpkg"
if [ "$(readlink "$link" 2>/dev/null || true)" != "$binary" ]; then
  ln -sfn "$binary" "$link"
fi

printf '%s\n' "$binary"
