#!/usr/bin/bash

set -Eeuo pipefail

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dotfiles="$(cd "$install_dir/../.." && pwd)"

mode="${1:-}"
if [[ "$mode" != --path && "$mode" != --binary-path && "$mode" != --cached-path ]] || [ "$#" -ne 1 ]; then
  printf 'Usage: %s --path|--binary-path|--cached-path\n' "$0" >&2
  exit 2
fi

binary="$(command -v "${DOTPKG_BIN:-dotpkg}" || true)"
if [ -z "$binary" ] || [ ! -x "$binary" ]; then
  printf 'dotpkg is not installed. Install dotpkg and add it to PATH.\n' >&2
  exit 2
fi

# Both lookup modes are read-only; --cached-path is kept for existing callers.
if [ "$mode" != --path ]; then
  printf '%s\n' "$binary"
  exit 0
fi

# Keep package declarations in git and machine state in the user config directory.
dotpkg_config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
dotpkg_config_dir="$dotpkg_config_home/dotpkg"
dotpkg_manifest="$dotpkg_config_dir/package.yaml"
dotpkg_state="$dotpkg_config_dir/state.yaml"
legacy_state="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/install/state.yaml"
manifest_missing=0
state_missing=0
[ -f "$dotpkg_manifest" ] || manifest_missing=1
[ -f "$dotpkg_state" ] || state_missing=1

if [ "$manifest_missing" -eq 1 ] || [ "$state_missing" -eq 1 ]; then
  "$binary" init >/dev/null
fi
if [ "$(readlink "$dotpkg_manifest" 2>/dev/null || true)" != "$dotfiles/linux/packages.yaml" ]; then
  if [ "$manifest_missing" -eq 0 ]; then
    mv "$dotpkg_manifest" "$dotpkg_manifest.bak.$(date +%Y%m%d%H%M%S%N)"
  fi
  ln -sfn "$dotfiles/linux/packages.yaml" "$dotpkg_manifest"
fi
if [ "$state_missing" -eq 1 ] && [ -f "$legacy_state" ]; then
  cp "$legacy_state" "$dotpkg_state"
  chmod 0600 "$dotpkg_state"
fi

printf '%s\n' "$binary"
