#!/usr/bin/bash

set -Eeuo pipefail

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: ./linux/install/all [options]

Reconcile this dotfiles profile through the manifest. The remaining imperative
helpers (`configs-system`, `icons`, `post`, `kmonad-device-manager`,
`opencode-desktop`) stay available when explicitly needed.

Options:
  --desktop    Install the desktop profile (default).
  --server     Reconcile the headless server profile.
  --host NAME  Apply the committed linux/hosts/NAME.yaml overlay.
  --dry-run    Print actions without changing the system.
  --replace    Replace existing config paths when creating symlinks.
  --help       Show this help message.
EOF
}

for arg in "$@"; do
  case $arg in
    --help|-h) usage; exit 0 ;;
  esac
done

source "$install_dir/common.sh"

exec "$install_dir/sync" "$@"
