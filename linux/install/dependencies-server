#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

# Keep the server profile in the official repositories: it needs no AUR helper.
run sudo pacman -S --needed --noconfirm \
  openssh docker docker-buildx docker-compose \
  git man-db wget zsh zsh-completions \
  neovim fd fzf ripgrep jq tree bat diff-so-fancy btop ttf-hack-nerd
