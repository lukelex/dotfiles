#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
source "$HOME/dotfiles/linux/variables.env"

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$install_dir/config-links.sh"

link_manifest_configs() {
  local mapping source target
  while IFS= read -r mapping; do
    case $mapping in
      *:*) ;;
      *)
        printf 'Invalid config mapping: %s\n' "$mapping" >&2
        return 1
        ;;
    esac
    source="$DOTFILES/${mapping%%:*}"
    target="${mapping#*:}"
    target="${target//\$HOME/$HOME}"
    target="${target//\$XDG_CONFIG_HOME/$XDG_CONFIG_HOME}"
    link_config "$source" "$target"
  done < <(manifest_package_configs "$1")
}

run mkdir -p "$XDG_CONFIG_HOME"
run mkdir -p "$HOME/.ssh"

link_manifest_configs '.common.packages'

if is_server; then
  exit 0
fi

run mkdir -p "$HOME/screenshots"
run mkdir -p "$HOME/.local/share/applications"
run mkdir -p "$HOME/backup_vim"
run mkdir -p "$HOME/projects"

link_manifest_configs '.profiles.desktop.packages'

run "$DOTFILES/linux/scripts/theme" init
run update-desktop-database "$HOME/.local/share/applications"
