#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
source "$HOME/dotfiles/linux/variables.env"

DOT_CONFIG="$DOTFILES/linux/config"

replace_existing=0
for arg in "$@"; do
  [ "$arg" = "--replace" ] && replace_existing=1
done

link_config() {
  local source="$1"
  local target="$2"
  if [ "$DRY_RUN" -eq 1 ]; then
    if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
      echo "ok: $target -> $source"
    elif [ -e "$target" ] || [ -L "$target" ]; then
      if [ "$replace_existing" = 1 ]; then
        echo "dry-run: would replace $target -> $source"
      else
        echo "dry-run: would skip $target (not a repo link; --replace to overwrite)"
      fi
    else
      echo "dry-run: would link $target -> $source"
    fi
    return 0
  fi
  mkdir -p "$(dirname "$target")"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
    echo "ok: $target -> $source"
  elif [ -e "$target" ] || [ -L "$target" ]; then
    if [ "$replace_existing" = 1 ]; then
      rm -rf "$target"
      ln -s "$source" "$target"
      echo "replaced: $target -> $source"
    else
      echo "skipping $target: exists and is not a repo link; rerun with --replace to overwrite" >&2
    fi
  else
    ln -s "$source" "$target"
    echo "linked: $target -> $source"
  fi
}

run mkdir -p "$XDG_CONFIG_HOME"
run mkdir -p "$HOME/.ssh"
run mkdir -p "$HOME/screenshots"
run mkdir -p "$HOME/.local/share/applications"
run mkdir -p "$HOME/backup_vim"
run mkdir -p "$HOME/projects"

link_config "$DOT_CONFIG/i3/main.conf" "$XDG_CONFIG_HOME/i3/config"
link_config "$DOT_CONFIG/hypr" "$XDG_CONFIG_HOME/hypr"
link_config "$DOT_CONFIG/waybar/config.json" "$XDG_CONFIG_HOME/waybar/config"
link_config "$DOT_CONFIG/waybar/style.css" "$XDG_CONFIG_HOME/waybar/style.css"
link_config "$DOT_CONFIG/zsh/zshrc" "$HOME/.zshrc"
link_config "$DOT_CONFIG/nvim" "$XDG_CONFIG_HOME/nvim"
link_config "$DOT_CONFIG/rofi" "$XDG_CONFIG_HOME/rofi"
link_config "$DOT_CONFIG/tofi.conf" "$XDG_CONFIG_HOME/tofi/config"
link_config "$DOT_CONFIG/gsimplecal" "$XDG_CONFIG_HOME/gsimplecal/config"
link_config "$DOT_CONFIG/wired/config.ron" "$XDG_CONFIG_HOME/wired/wired.ron"
link_config "$DOT_CONFIG/gammastep/config.ini" "$XDG_CONFIG_HOME/gammastep/config.ini"
link_config "$DOT_CONFIG/kitty" "$XDG_CONFIG_HOME/kitty"
link_config "$DOT_CONFIG/flameshot.ini" "$XDG_CONFIG_HOME/flameshot/flameshot.ini"
link_config "$DOTFILES/linux/Xresources" "$HOME/.Xresources"
link_config "$DOTFILES/linux/profile" "$HOME/.profile"
link_config "$DOTFILES/linux/xprofile" "$HOME/.xprofile"
link_config "$DOTFILES/linux/xinitrc" "$HOME/.xinitrc"
link_config "$DOT_CONFIG/eww" "$XDG_CONFIG_HOME/eww"
link_config "$DOT_CONFIG/greenclip.toml" "$XDG_CONFIG_HOME/greenclip.toml"
link_config "$DOT_CONFIG/default-apps.list" "$HOME/.local/share/applications/defaults.list"
link_config "$DOT_CONFIG/fonts.conf" "$XDG_CONFIG_HOME/fontconfig/fonts.conf"
link_config "$DOT_CONFIG/autorandr/postswitch" "$XDG_CONFIG_HOME/autorandr/postswitch"
link_config "$DOT_CONFIG/mimeapps.conf" "$HOME/.local/share/applications/mimeapps.list"
link_config "$DOT_CONFIG/mimeapps.conf" "$XDG_CONFIG_HOME/mimeapps.list"
link_config "$DOT_CONFIG/opencode" "$XDG_CONFIG_HOME/opencode"
link_config "$DOT_CONFIG/kmonad/kmonad.service" "$XDG_CONFIG_HOME/systemd/user/kmonad.service"

run "$DOTFILES/linux/scripts/theme" init
run update-desktop-database "$HOME/.local/share/applications"
