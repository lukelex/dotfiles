#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
wm_selection="$HOME/.config/dotfiles/wm-selection"

mapfile -t packages < <(
  manifest_packages '.common.packages.core'
  manifest_packages ".profiles.$INSTALL_PROFILE.packages.core"
)

if is_server; then
  run sudo pacman -S --needed --noconfirm "${packages[@]}"
  exit 0
elif [ "$DRY_RUN" -eq 1 ]; then
  echo "dry-run: bootstrap yay from AUR if missing"
elif ! command -v yay &> /dev/null
then
  ( "$install_dir/yay" )
fi

if [ "$DRY_RUN" -eq 1 ]; then
  echo "dry-run: reset wm-selection file"
else
  mkdir -p "$(dirname "$wm_selection")"
  : > "$wm_selection"
fi

run yay -S --needed --noconfirm "${packages[@]}"

answer="$(ask 'Would you like to install Hyprland? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing Wayland dependencies...'
    mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.hyprland')
    run yay -S --needed --noconfirm "${packages[@]}"
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "dry-run: record wm selection: hypr"
    else
      echo hypr >> "$wm_selection"
    fi
    ;;
  * ) ;;
esac

answer="$(ask 'Would you like to install i3wm? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing X.Org dependencies...'
    mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.i3')
    run yay -S --needed --noconfirm "${packages[@]}"
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "dry-run: record wm selection: i3"
    else
      echo i3 >> "$wm_selection"
    fi
    ;;
  * ) ;;
esac

mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.extras')
run yay -S --needed --noconfirm "${packages[@]}" \
  2> /dev/null

answer="$(ask 'Would you like to be able to sync your iPod? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing iPod dependencies...'
    mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.ipod')
    run yay -S --needed --noconfirm "${packages[@]}"
    ;;
  * ) ;;
esac

# Audio manipulation tools
# ffmpeg

answer="$(ask 'Would you like to install optional dependencies? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing optional dependencies...'
    mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.optional')
    run yay -S --needed --noconfirm "${packages[@]}"
    ;;
  * ) ;;
esac

if eval lspci -k | grep -A 2 -E "(VGA|3D)" | grep 'nvidia'; then
  answer="$(ask "I've found an NVidia GPU. Would you like to install its driver? [Y/n] ")"
  case $answer in
    [Yy]* | "")
      mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.nvidia')
      run yay -S --needed --noconfirm "${packages[@]}" ;;
    * ) ;;
  esac

  answer="$(ask 'Would you like to install NVIDIA Settings? [y/N] ')"
  case $answer in
    [Yy]*)
      mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.nvidia-gui')
      run yay -S --needed --noconfirm "${packages[@]}" ;;
    * ) ;;
  esac
fi

run rustup default stable

run sudo yay -Sc
