#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
wm_selection="$HOME/.config/dotfiles/wm-selection"

mapfile -t packages < <(
  manifest_packages '.common.packages.headless'
  manifest_packages ".profiles.$INSTALL_PROFILE.packages.$([ "$INSTALL_PROFILE" = desktop ] && printf desktop || printf headless)"
)

if is_server; then
  run sudo pacman -S --needed --noconfirm "${packages[@]}"
  exit 0
elif [ "$DRY_RUN" -eq 1 ]; then
  echo "dry-run: bootstrap yay from AUR if missing"
elif ! command -v yay &> /dev/null
then
  ( "$install_dir/yay" )
fi

if [ "$DRY_RUN" -eq 1 ]; then
  echo "dry-run: reset wm-selection file"
else
  mkdir -p "$(dirname "$wm_selection")"
  : > "$wm_selection"
fi

run yay -S --needed --noconfirm "${packages[@]}"

answer="$(ask 'Would you like to install Hyprland? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing Wayland dependencies...'
    mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.hyprland')
    run yay -S --needed --noconfirm "${packages[@]}"
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "dry-run: record wm selection: hypr"
    else
      echo hypr >> "$wm_selection"
    fi
    ;;
  * ) ;;
esac

answer="$(ask 'Would you like to install i3wm? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing X.Org dependencies...'
    mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.i3')
    run yay -S --needed --noconfirm "${packages[@]}"
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "dry-run: record wm selection: i3"
    else
      echo i3 >> "$wm_selection"
    fi
    ;;
  * ) ;;
esac

mapfile -t packages < <(manifest_packages '.profiles.desktop.packages.extras')
run yay -S --needed --noconfirm "${packages[@]}" 2> /dev/null

mapfile -t option_names < <(manifest_option_names '.profiles.desktop.options')
for option in "${option_names[@]}"; do
  prompt="$(manifest_option_prompt ".profiles.desktop.options.$option")"
  default="$(manifest_option_default ".profiles.desktop.options.$option")"
  answer="$(ask "$prompt ")"
  case $answer in
    [Yy]*) install_option=1 ;;
    "") [ "$default" = yes ] && install_option=1 || install_option=0 ;;
    *) install_option=0 ;;
  esac
  if [ "$install_option" -eq 1 ]; then
    mapfile -t packages < <(manifest_option_packages ".profiles.desktop.options.$option")
    run yay -S --needed --noconfirm "${packages[@]}"
  fi
done

run rustup default stable

run sudo yay -Sc
