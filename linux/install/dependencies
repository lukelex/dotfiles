#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
wm_selection="$HOME/.config/dotfiles/wm-selection"

if [ "$DRY_RUN" -eq 1 ]; then
  echo "dry-run: bootstrap yay from AUR if missing"
elif ! command -v yay &> /dev/null
then
  ( "$install_dir/yay" )
fi

if [ "$DRY_RUN" -eq 1 ]; then
  echo "dry-run: reset wm-selection file"
else
  mkdir -p "$(dirname "$wm_selection")"
  : > "$wm_selection"
fi

# essentials
run yay -S --needed --noconfirm ibus openssh \
  polkit polkit-gnome network-manager-applet \
  man-db wget ttf-hack ttf-hack-nerd noto-fonts-cjk bc zsh \
  zsh-completions cmake jq tidy yazi pcmanfm \
  imagemagick blueman fragments playerctl inetutils \
  tree v4l-utils neovim fd fzf ripgrep rustup kmonad \
  kitty bat diff-so-fancy pavucontrol pipewire-jack pipewire-alsa \
  pipewire-pulse google-chrome dbus udiskie

answer="$(ask 'Would you like to install Hyprland? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing Wayland dependencies...'
    run yay -S --needed --noconfirm hyprland wdisplays cliphist awww \
      swhkd hypridle hyprlock hyprpanel-bin hyprshot \
      qt5-wayland qt6-wayland tofi sox slurp wf-recorder \
      xdg-desktop-portal-hyprland kooha
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "dry-run: record wm selection: hypr"
    else
      echo hypr >> "$wm_selection"
    fi
    ;;
  * ) ;;
esac

answer="$(ask 'Would you like to install i3wm? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing X.Org dependencies...'
    run yay -S --needed --noconfirm xorg-server xorg-xinit i3-wm \
      xss-lock xwallpaper xautolock xorg-xkill i3lock polybar \
      xfce4-power-manager flameshot arandr xclip xdotool wired \
      simplescreenrecorder picom autorandr eww sxhkd \
      rofi rofi-greenclip rofi-bluetooth-git sddm qt6-svg
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "dry-run: record wm selection: i3"
    else
      echo i3 >> "$wm_selection"
    fi
    ;;
  * ) ;;
esac

# non-essentials
run yay -S --needed --noconfirm light ddcutil gammastep \
  1password spotify cups ghostscript kbt cameractrls \
  zeal vlc zip unzip unrar btop seadrive-gui \
  pantheon-calculator tldr docker docker-buildx docker-compose \
  rubygems npm fastfetch blanket sxiv postbird \
  sysstat viewnior zathura zathura-pdf-mupdf etcher-bin \
  system-config-printer fprintd downgrade cifs-utils smbclient \
  2> /dev/null

answer="$(ask 'Would you like to be able to sync your iPod? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing iPod dependencies...'
    run yay -S --needed --noconfirm rhythmbox libgpod gvfs
    ;;
  * ) ;;
esac

# Audio manipulation tools
# ffmpeg

answer="$(ask 'Would you like to install optional dependencies? [Y/n] ')"
case $answer in
  [Yy]* | "")
    echo 'Installing optional dependencies...'
    run yay -S --needed --noconfirm kicad curtail birdfont \
      whatsapp-for-linux telegram-desktop discord via-appimage \
      slack-desktop
    ;;
  * ) ;;
esac

if eval lspci -k | grep -A 2 -E "(VGA|3D)" | grep 'nvidia'; then
  answer="$(ask "I've found an NVidia GPU. Would you like to install its driver and utilities? [Y/n] ")"
  case $answer in
    [Yy]* | "")
      run yay -S --needed --noconfirm nvidia nvidia-settings nvidia-prime ;;
    * ) ;;
  esac
fi

run rustup default stable

run sudo yay -Sc