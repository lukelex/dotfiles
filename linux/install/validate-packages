#!/usr/bin/bash

set -Eeuo pipefail

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$install_dir/common.sh"

usage() {
  cat <<'EOF'
Usage: ./linux/install/validate-packages [--host NAME] [--package NAME]...

Validate the selected manifest packages and their explicit origins. Repository
packages are checked locally; AUR packages use the AUR RPC API.
EOF
}

skip_next=0
for arg in "$@"; do
  if [ "$skip_next" -eq 1 ]; then
    skip_next=0
    continue
  fi
  case $arg in
    --help|-h) usage; exit 0 ;;
    --desktop|--server|--dry-run|--check) ;;
    --host|--package) skip_next=1 ;;
    --host=*|--package=*) ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; usage >&2; exit 2 ;;
  esac
done

command -v pacman >/dev/null || { printf 'pacman is required\n' >&2; exit 2; }
command -v curl >/dev/null || { printf 'curl is required\n' >&2; exit 2; }

package_categories=('.common.packages.headless' ".profiles.$INSTALL_PROFILE.packages.$([ "$INSTALL_PROFILE" = desktop ] && printf desktop || printf headless)")
if ! is_server; then
  package_categories+=('.profiles.desktop.packages.extras' '.profiles.desktop.packages.hyprland' '.profiles.desktop.packages.i3')
  while IFS= read -r option; do package_categories+=(".profiles.desktop.options.$option.packages"); done < <(manifest_option_names '.profiles.desktop.options')
fi

mapfile -t packages < <(
  for category in "${package_categories[@]}"; do manifest_packages "$category"; done | sort -u
)

extra_packages=()
skip_next=0
for arg in "$@"; do
  if [ "$skip_next" -eq 1 ]; then
    extra_packages+=("$arg")
    skip_next=0
    continue
  fi
  case $arg in
    --package) skip_next=1 ;;
    --package=*) extra_packages+=("${arg#--package=}") ;;
  esac
done
packages+=("${extra_packages[@]}")
mapfile -t packages < <(printf '%s\n' "${packages[@]}" | sort -u)

declare -A repository_packages aur_packages
while IFS= read -r package; do
  repository_packages["$package"]=1
done < <(pacman -Slq | sort -u)

repo_candidates=()
aur_candidates=()
for package in "${packages[@]}"; do
  case "$(manifest_package_origin "$package")" in
    repo) repo_candidates+=("$package") ;;
    aur) aur_candidates+=("$package") ;;
    *) printf 'Missing package origin: %s\n' "$package" >&2; exit 1 ;;
  esac
done

missing=()
for package in "${repo_candidates[@]}"; do
  [ -n "${repository_packages[$package]:-}" ] || missing+=("$package")
done

for ((start = 0; start < ${#aur_candidates[@]}; start += 200)); do
  batch=("${aur_candidates[@]:start:200}")
  curl_args=(--fail --silent --show-error --get 'https://aur.archlinux.org/rpc/v5/info')
  for package in "${batch[@]}"; do
    curl_args+=(--data-urlencode "arg[]=$package")
  done

  response="$(curl "${curl_args[@]}")" || {
    printf 'AUR package lookup failed\n' >&2
    exit 2
  }
  while IFS= read -r package; do
    aur_packages["$package"]=1
  done < <(printf '%s\n' "$response" | "$YQ" -r '.results[].Name')
done

for package in "${aur_candidates[@]}"; do
  [ -n "${aur_packages[$package]:-}" ] || [ -n "${repository_packages[$package]:-}" ] || missing+=("$package")
done

printf 'Validated %d manifest packages: %d repository, %d AUR\n' \
  "${#packages[@]}" "${#repo_candidates[@]}" "${#aur_candidates[@]}"
if [ "${#missing[@]}" -gt 0 ]; then
  printf 'Missing packages:\n' >&2
  printf '  %s\n' "${missing[@]}" >&2
  exit 1
fi
