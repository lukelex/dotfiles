#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh" "$@"
source "$DOTFILES/linux/variables.env"

state_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotpkg/state.yaml"

has_wm() {
  [ -f "$state_file" ] && [ "$("$YQ" -r ".current.selections.$1" "$state_file")" = true ]
}

# One-off setup steps that dotpkg cannot express as declarative resources:
# user directories, interactive prompts, and host tweaks.

# Run a command only when the tool is actually installed; optional tools
# (rustup, tldr, desktop-file-utils, xorg-xset) are not guaranteed by the
# manifest, and post must not abort the whole install when one is missing.
if_available() {
  if command -v "$1" >/dev/null 2>&1; then
    shift
    run "$@"
  fi
}

run mkdir -p "$XDG_CONFIG_HOME"
run mkdir -p "$HOME/.ssh"
run mkdir -p "$HOME/projects"

if ! is_server; then
  run mkdir -p "$HOME/screenshots"
  run mkdir -p "$HOME/.local/share/applications"
  run mkdir -p "$HOME/.vim-cache/undodir" "$HOME/.vim-cache/backup"

  run "$DOTFILES/linux/scripts/theme" init
  if_available update-desktop-database update-desktop-database "$HOME/.local/share/applications"

  if_available xset xset dpms 1200 0 0
fi

answer="$(ask 'Set your login shell to zsh? [Y/n] ')"
case $answer in
  [Yy]* | "")
    run chsh -s /usr/bin/zsh
    ;;
  * ) ;;
esac

run fc-cache -r
if_available tldr tldr -u
run sudo mandb

answer="$(ask 'Set system timezone to CET? [Y/n] ')"
case $answer in
  [Yy]* | "")
    run timedatectl set-timezone CET
    ;;
  * ) ;;
esac

if_available rustup rustup default stable
run sudo yay -Sc

if has_wm i3 || has_wm hyprland; then
  if [ -e /usr/share/dbus-1/services/org.xfce.xfce4-notifyd.Notifications.service ] \
    && [ ! -e /usr/share/dbus-1/services/org.xfce.xfce4-notifyd.Notifications.service.disabled ]; then
    run sudo mv /usr/share/dbus-1/services/org.xfce.xfce4-notifyd.Notifications.service{,.disabled}
  fi
fi
