#!/usr/bin/bash

set -Eeuo pipefail

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$install_dir/common.sh"
source "$DOTFILES/linux/variables.env"
source "$install_dir/config-links.sh"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  BLUE=$'\033[34m'
  GREEN=$'\033[32m'
  RED=$'\033[31m'
  YELLOW=$'\033[33m'
  RESET=$'\033[0m'
else
  BOLD=''
  DIM=''
  BLUE=''
  GREEN=''
  RED=''
  YELLOW=''
  RESET=''
fi

usage() {
  cat <<'EOF'
Usage: ./linux/install/sync [options]

Reconcile the selected profile with linux/packages.yaml. Each stage requires
confirmation before changing the system:
  packages  Install required packages and remove tracked packages no longer declared.
  groups    Reconcile groups required by declared packages.
  configs   Create declared config links and remove tracked links no longer declared.
  services  Enable declared services and disable tracked services no longer declared.

Only resources tracked in $XDG_STATE_HOME/dotfiles/install are eligible for
removal. The first confirmed run adopts matching declared resources.

Options:
  --desktop    Reconcile the desktop profile (default).
  --server     Reconcile the headless server profile.
  --host NAME  Apply the committed linux/hosts/NAME.yaml overlay.
  --packages-only  Reconcile packages and their tracking state only.
  --dry-run    Print proposed changes without changing the system.
  --replace    Replace existing config paths when creating symlinks.
  --help       Show this help message.

The package stage remains Bash-owned by default. Set DOTPKG_PACKAGE_STAGE=1 to
opt into the standalone package reconciler. Set DOTPKG_RESOURCES=1 as well to
delegate groups, config links, and services to dotpkg and stop after its full
resource sync. The pinned, checksum-verified release is downloaded and cached
automatically; set DOTPKG_BIN to override it with an explicitly provisioned
executable.
EOF
}

print_stage_heading() {
  local stage="$1"
  printf '\n%s%s%s\n' "$BOLD$BLUE" "${stage^^}" "$RESET"
  printf '%s----------------------------------------%s\n' "$DIM" "$RESET"
}

print_in_sync() {
  print_stage_heading "$1"
  printf '  %sok%s already synchronized\n' "$GREEN" "$RESET"
}

for arg in "$@"; do
  case $arg in
    --help|-h) usage; exit 0 ;;
  esac
done

"$install_dir/preflight" "$@"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/install"
state_file="$state_dir/state.yaml"

contains() {
  local needle="$1"
  shift
  local value
  for value in "$@"; do
    [ "$value" = "$needle" ] && return 0
  done
  return 1
}

read_legacy_state() {
  local name="$1"
  local -n result="$2"
  local file="$state_dir/$name"
  result=()
  [ -f "$file" ] && mapfile -t result < "$file"
  return 0
}

ensure_state_file() {
  [ -f "$state_file" ] && return

  local temporary name item
  temporary="$(mktemp "$state_dir/state.yaml.XXXXXX")"
  {
    printf 'version: 1\ncurrent:\n'
    printf '  profile: %s\n' "$INSTALL_PROFILE"
    printf '  host: %s\n' "$INSTALL_HOST"
    printf '  manifest_sha256: %s\n' "$(sha256sum "$INSTALL_MANIFEST" | cut -d' ' -f1)"
    printf 'managed:\n'
    for name in packages groups configs services; do
      printf '  %s:\n' "$name"
      local entries=()
      read_legacy_state "$name" entries
      for item in "${entries[@]}"; do
        printf '    - %s\n' "$item"
      done
    done
  } > "$temporary"
  mv "$temporary" "$state_file"
  rm -f "$state_dir"/packages "$state_dir"/groups "$state_dir"/configs "$state_dir"/services
}

read_state() {
  local name="$1"
  local result_name="$2"
  local -n result="$result_name"
  result=()
  if [ -f "$state_file" ]; then
    mapfile -t result < <("$YQ" -r ".managed.${name}[]?" "$state_file")
  else
    read_legacy_state "$name" "$result_name"
  fi
}

write_state() {
  local name="$1"
  shift
  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'dry-run: record managed %s\n' "$name"
    return
  fi
  mkdir -p "$state_dir"
  ensure_state_file
  local temporary item
  temporary="$(mktemp "$state_dir/state.yaml.XXXXXX")"
  cp "$state_file" "$temporary"
  "$YQ" -i ".current.profile = \"$INSTALL_PROFILE\" | .current.host = \"$INSTALL_HOST\" | .current.manifest_sha256 = \"$(sha256sum "$INSTALL_MANIFEST" | cut -d' ' -f1)\" | .managed.$name = []" "$temporary"
  for item in "$@"; do
    ITEM="$item" "$YQ" -i ".managed.$name += [strenv(ITEM)]" "$temporary"
  done
  mv "$temporary" "$state_file"
}

sort_state_packages() {
  [ "$DRY_RUN" -eq 0 ] && [ -f "$state_file" ] || return
  local temporary package
  local packages=()
  mapfile -t packages < <("$YQ" -r '.managed.packages[]?' "$state_file" | sort -u)
  temporary="$(mktemp "$state_dir/state.yaml.XXXXXX")"
  cp "$state_file" "$temporary"
  "$YQ" -i '.managed.packages = []' "$temporary"
  for package in "${packages[@]}"; do
    ITEM="$package" "$YQ" -i '.managed.packages += [strenv(ITEM)]' "$temporary"
  done
  mv "$temporary" "$state_file"
}

sort_manifest_packages() {
  [ "$DRY_RUN" -eq 0 ] || return
  local manifest="$DOTFILES/linux/packages.yaml"
  local temporary
  temporary="$(mktemp "$DOTFILES/linux/packages.yaml.XXXXXX")"
  cp "$manifest" "$temporary"
  "$YQ" -i '.common.packages.headless |= sort_keys(.) | .profiles.desktop.packages.desktop |= sort_keys(.) | .profiles.desktop.packages.hyprland |= sort_keys(.) | .profiles.desktop.packages.i3 |= sort_keys(.) | .profiles.desktop.packages.extras |= sort_keys(.) | .profiles.server.packages.headless |= sort_keys(.) | with(.profiles.desktop.options[]; .packages |= sort_keys(.)) | .profiles.desktop = {"packages": .profiles.desktop.packages, "options": .profiles.desktop.options} | .profiles = {"desktop": .profiles.desktop, "server": .profiles.server} | . = {"source": .source, "common": .common, "profiles": .profiles}' "$temporary"
  mv "$temporary" "$manifest"
}

if [ "$DRY_RUN" -eq 0 ] && [ ! -f "$state_file" ] \
  && { [ -f "$state_dir/packages" ] || [ -f "$state_dir/groups" ] || [ -f "$state_dir/configs" ] || [ -f "$state_dir/services" ]; }; then
  mkdir -p "$state_dir"
  ensure_state_file
fi

selection_value() {
  local path="$1"
  "$YQ" -r ".current.selections.$path" "$state_file"
}

selection_recorded() {
  local path="$1"
  [ -f "$state_file" ] && [ "$("$YQ" -r ".current.selections.$path != null" "$state_file")" = true ]
}

initialize_desktop_selections() {
  is_server && return
  if [ "$DRY_RUN" -eq 1 ]; then
    return
  fi

  mkdir -p "$state_dir"
  ensure_state_file
  local temporary selection option answer category title
  temporary="$(mktemp "$state_dir/state.yaml.XXXXXX")"
  cp "$state_file" "$temporary"
  for selection in extras hyprland i3; do
    selection_recorded "$selection" && continue
    case $selection in
      extras) category='.profiles.desktop.packages.extras'; title='Desktop extras' ;;
      hyprland) category='.profiles.desktop.packages.hyprland'; title='Hyprland' ;;
      i3) category='.profiles.desktop.packages.i3'; title='i3/X11' ;;
    esac
    printf '\n%s includes:\n' "$title"
    manifest_packages "$category" | paste -sd ', ' | fold -s -w 88 | sed 's/^/  /'
    answer="$(ask "Install $title? [y/N] ")"
    case $answer in [Yy]*) value=true ;; *) value=false ;; esac
    "$YQ" -i ".current.selections.$selection = $value" "$temporary"
  done
  local options=()
  mapfile -t options < <(manifest_option_names '.profiles.desktop.options')
  for option in "${options[@]}"; do
    selection_recorded "options.$option" && continue
    printf '\nOptional set %s includes:\n' "$option"
    manifest_option_packages ".profiles.desktop.options.$option" | paste -sd ', ' | fold -s -w 88 | sed 's/^/  /'
    answer="$(ask "Install optional set '$option'? [y/N] ")"
    case $answer in [Yy]*) value=true ;; *) value=false ;; esac
    "$YQ" -i ".current.selections.options.$option = $value" "$temporary"
  done
  mv "$temporary" "$state_file"
}

initialize_desktop_selections

if ! is_server && [ "$DRY_RUN" -eq 1 ]; then
  for selection in extras hyprland i3; do
    if ! selection_recorded "$selection"; then
      printf 'No recorded desktop selections; run sync without --dry-run first.\n' >&2
      exit 2
    fi
  done
  while IFS= read -r option; do
    if ! selection_recorded "options.$option"; then
      printf 'No recorded desktop selections; run sync without --dry-run first.\n' >&2
      exit 2
    fi
  done < <(manifest_option_names '.profiles.desktop.options')
fi

confirm_stage() {
  local stage="$1"
  shift
  local change label adopted=0

  print_stage_heading "$stage"
  for change in "$@"; do
    case $change in
      adopt:*)
        adopted=$((adopted + 1))
        ;;
      install:*|add\ user\ to:*|enable:*|link:*)
        label="${change#*: }"
        printf '  %s+%s %s\n' "$GREEN" "$RESET" "$label"
        ;;
      remove:*|disable:*|unlink:*)
        label="${change#*: }"
        printf '  %s-%s %s\n' "$RED" "$RESET" "$label"
        ;;
      *)
        printf '  %s~%s %s\n' "$YELLOW" "$RESET" "$change"
        ;;
    esac
  done
  if [ "$adopted" -gt 0 ]; then
    printf '  %s~%s adopt %d existing resource(s)\n' "$DIM" "$RESET" "$adopted"
  fi
  answer="$(ask "Apply $stage changes? [y/N] ")"
  [[ "$answer" =~ ^[Yy]$ ]]
}

package_categories=('.common.packages.headless' ".profiles.$INSTALL_PROFILE.packages.$([ "$INSTALL_PROFILE" = desktop ] && printf desktop || printf headless)")
resource_categories=('.common.packages' ".profiles.$INSTALL_PROFILE.packages.$([ "$INSTALL_PROFILE" = desktop ] && printf desktop || printf headless)")
selected_wms=()
if ! is_server; then
  resource_categories+=('.profiles.desktop.packages.dotfiles')
  if [ "$(selection_value extras)" = true ]; then
    package_categories+=('.profiles.desktop.packages.extras')
    resource_categories+=('.profiles.desktop.packages.extras')
  fi
  if [ "$(selection_value hyprland)" = true ]; then
    package_categories+=('.profiles.desktop.packages.hyprland')
    resource_categories+=('.profiles.desktop.packages.hyprland')
    selected_wms+=(Hyprland)
  fi
  if [ "$(selection_value i3)" = true ]; then
    package_categories+=('.profiles.desktop.packages.i3')
    resource_categories+=('.profiles.desktop.packages.i3')
    selected_wms+=(i3)
  fi
  while IFS= read -r option; do
    package_categories+=(".profiles.desktop.options.$option.packages")
    resource_categories+=(".profiles.desktop.options.$option.packages")
  done < <(manifest_option_names '.profiles.desktop.options' | while IFS= read -r option; do [ "$(selection_value "options.$option")" = true ] && printf '%s\n' "$option"; done)
fi

if is_server; then
  printf '%sSyncing server profile%s\n' "$BOLD" "$RESET"
elif [ "${#selected_wms[@]}" -eq 0 ]; then
  printf '%sSyncing desktop profile%s %s(no window manager selected)%s\n' "$BOLD" "$RESET" "$YELLOW" "$RESET"
else
  printf '%sSyncing desktop profile%s %s(%s)%s\n' "$BOLD" "$RESET" "$DIM" "${selected_wms[*]}" "$RESET"
fi

packages_from_categories() {
  local category
  for category in "$@"; do
    manifest_packages "$category"
  done
}

mapfile -t declared_packages < <(
  packages_from_categories "${package_categories[@]}" | sort -u
)

if [ "${DOTPKG_PACKAGE_STAGE:-0}" = 1 ]; then
  dotpkg_args=(
    --manifest "$DOTFILES/linux/packages.yaml"
    --state-file "$state_file"
    --profile "$INSTALL_PROFILE"
  )
  [ -z "$INSTALL_HOST" ] || dotpkg_args+=(--host "$INSTALL_HOST")
  [ "$DRY_RUN" -eq 0 ] || dotpkg_args+=(--dry-run)
  [ "${DOTPKG_YES:-0}" = 1 ] && dotpkg_args+=(--yes)
  if [ "${DOTPKG_RESOURCES:-0}" = 1 ]; then
    dotpkg_args+=(--resources --root "$DOTFILES")
    [ "${DOTPKG_REPLACE:-0}" = 1 ] && dotpkg_args+=(--replace)
  fi
  "$install_dir/dotpkg-package-stage" "${dotpkg_args[@]}"
  if [ "$PACKAGES_ONLY" -eq 1 ] || [ "${DOTPKG_RESOURCES:-0}" = 1 ]; then
    exit 0
  fi
else
  read_state packages tracked_packages
  adopted_packages=()
  if [ ! -f "$state_file" ] && [ ! -f "$state_dir/packages" ]; then
    tracked_packages=()
    for package in "${declared_packages[@]}"; do
      if pacman -Q "$package" >/dev/null 2>&1; then
        adopted_packages+=("$package")
        tracked_packages+=("$package")
      fi
    done
  else
    for package in "${declared_packages[@]}"; do
      if pacman -Q "$package" >/dev/null 2>&1 && ! contains "$package" "${tracked_packages[@]}"; then
        adopted_packages+=("$package")
        tracked_packages+=("$package")
      fi
    done
  fi

  missing_packages=()
  for package in "${declared_packages[@]}"; do
    pacman -Q "$package" >/dev/null 2>&1 || missing_packages+=("$package")
  done
  extra_packages=()
  for package in "${tracked_packages[@]}"; do
    contains "$package" "${declared_packages[@]}" || extra_packages+=("$package")
  done

  package_changes=()
  for package in "${adopted_packages[@]}"; do package_changes+=("adopt: $package"); done
  for package in "${missing_packages[@]}"; do package_changes+=("install: $package"); done
  for package in "${extra_packages[@]}"; do package_changes+=("remove: $package"); done
  if [ "${#package_changes[@]}" -gt 0 ] && confirm_stage packages "${package_changes[@]}"; then
    if [ "${#missing_packages[@]}" -gt 0 ]; then
      repo_packages=()
      aur_packages=()
      for package in "${missing_packages[@]}"; do
        case "$(manifest_package_origin "$package")" in
          repo) repo_packages+=("$package") ;;
          aur) aur_packages+=("$package") ;;
          *) printf 'Missing package origin: %s\n' "$package" >&2; exit 2 ;;
        esac
      done
      [ "${#repo_packages[@]}" -eq 0 ] || run sudo pacman -S --needed --noconfirm "${repo_packages[@]}"
      if [ "${#aur_packages[@]}" -gt 0 ]; then
        if ! command -v yay >/dev/null; then
          run "$install_dir/yay"
        fi
        run yay -S --needed --noconfirm "${aur_packages[@]}"
      fi
    fi
    if [ "${#extra_packages[@]}" -gt 0 ]; then
      if is_server; then
        run sudo pacman -Rns --noconfirm "${extra_packages[@]}"
      else
        run yay -Rns --noconfirm "${extra_packages[@]}"
      fi
    fi
    next_packages=()
    for package in "${tracked_packages[@]}"; do
      contains "$package" "${extra_packages[@]}" || next_packages+=("$package")
    done
    next_packages+=("${missing_packages[@]}")
    write_state packages "${next_packages[@]}"
  elif [ "${#package_changes[@]}" -eq 0 ]; then
    print_in_sync packages
  fi

  if [ "$PACKAGES_ONLY" -eq 1 ]; then
    sort_state_packages
    exit 0
  fi
fi

category_expression="(${resource_categories[0]}"
for category in "${resource_categories[@]:1}"; do
  category_expression+=", $category"
done
category_expression+=")"
mapfile -t declared_groups < <(manifest_package_groups "$category_expression" | sort -u)
read_state groups tracked_groups
current_groups=( $(id -nG "$USER") )
adopted_groups=()
if [ ! -f "$state_file" ] && [ ! -f "$state_dir/groups" ]; then
  for group in "${declared_groups[@]}"; do
    contains "$group" "${current_groups[@]}" && adopted_groups+=("$group")
  done
  tracked_groups=("${adopted_groups[@]}")
fi
missing_groups=()
for group in "${declared_groups[@]}"; do
  if ! getent group "$group" >/dev/null; then
    printf 'skipping unavailable group: %s\n' "$group"
  elif ! contains "$group" "${current_groups[@]}"; then
    missing_groups+=("$group")
  fi
done
extra_groups=()
for group in "${tracked_groups[@]}"; do
  contains "$group" "${declared_groups[@]}" || extra_groups+=("$group")
done
group_changes=()
for group in "${adopted_groups[@]}"; do group_changes+=("adopt: $group"); done
for group in "${missing_groups[@]}"; do group_changes+=("add user to: $group"); done
for group in "${extra_groups[@]}"; do group_changes+=("remove user from: $group"); done
if [ "${#group_changes[@]}" -gt 0 ] && confirm_stage groups "${group_changes[@]}"; then
  for group in "${missing_groups[@]}"; do run sudo usermod -aG "$group" "$USER"; done
  for group in "${extra_groups[@]}"; do run sudo gpasswd -d "$USER" "$group"; done
  if [ "${#missing_groups[@]}" -gt 0 ] || [ "${#extra_groups[@]}" -gt 0 ]; then
    group_logout_notice
  fi
  next_groups=()
  for group in "${tracked_groups[@]}"; do
    contains "$group" "${extra_groups[@]}" || next_groups+=("$group")
  done
  next_groups+=("${missing_groups[@]}")
  write_state groups "${next_groups[@]}"
elif [ "${#group_changes[@]}" -eq 0 ]; then
  print_in_sync groups
fi

expand_target() {
  local target="$1"
  target="${target//\$HOME/$HOME}"
  target="${target//\$XDG_CONFIG_HOME/$XDG_CONFIG_HOME}"
  printf '%s\n' "$target"
}

mapfile -t declared_configs < <(
  for category in "${resource_categories[@]}"; do manifest_package_configs "$category"; done
)
read_state configs tracked_configs
adopted_configs=()
if [ ! -f "$state_file" ] && [ ! -f "$state_dir/configs" ]; then
  for mapping in "${declared_configs[@]}"; do
    source="$DOTFILES/${mapping%%:*}"
    target="$(expand_target "${mapping#*:}")"
    [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ] && adopted_configs+=("$mapping")
  done
  tracked_configs=("${adopted_configs[@]}")
fi
missing_configs=()
for mapping in "${declared_configs[@]}"; do
  source="$DOTFILES/${mapping%%:*}"
  target="$(expand_target "${mapping#*:}")"
  [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ] || missing_configs+=("$mapping")
done
extra_configs=()
for mapping in "${tracked_configs[@]}"; do
  contains "$mapping" "${declared_configs[@]}" || extra_configs+=("$mapping")
done
config_changes=()
for mapping in "${adopted_configs[@]}"; do config_changes+=("adopt: $mapping"); done
for mapping in "${missing_configs[@]}"; do config_changes+=("link: $mapping"); done
for mapping in "${extra_configs[@]}"; do config_changes+=("unlink: $mapping"); done
if [ "${#config_changes[@]}" -gt 0 ] && confirm_stage configs "${config_changes[@]}"; then
  for mapping in "${missing_configs[@]}"; do
    link_config "$DOTFILES/${mapping%%:*}" "$(expand_target "${mapping#*:}")"
  done
  for mapping in "${extra_configs[@]}"; do
    source="$DOTFILES/${mapping%%:*}"
    target="$(expand_target "${mapping#*:}")"
    [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ] && run rm "$target"
  done
  next_configs=()
  for mapping in "${tracked_configs[@]}"; do
    contains "$mapping" "${extra_configs[@]}" || next_configs+=("$mapping")
  done
  for mapping in "${missing_configs[@]}"; do
    source="$DOTFILES/${mapping%%:*}"
    target="$(expand_target "${mapping#*:}")"
    [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ] && next_configs+=("$mapping")
  done
  write_state configs "${next_configs[@]}"
elif [ "${#config_changes[@]}" -eq 0 ]; then
  print_in_sync configs
fi

services_from_categories() {
  local scope="$1"
  shift
  local service
  while IFS= read -r service; do
    if [ "$scope" = user ]; then
      printf 'user:%s\n' "$service"
    else
      printf '%s\n' "$service"
    fi
  done < <(manifest_package_services "$scope" "$@")
}

mapfile -t declared_services < <(
  {
    services_from_categories system "${package_categories[@]}"
    services_from_categories user "${package_categories[@]}"
  } | sort -u
)
read_state services tracked_services
adopted_services=()
if [ ! -f "$state_file" ] && [ ! -f "$state_dir/services" ]; then
  tracked_services=()
fi
missing_services=()
for service in "${declared_services[@]}"; do
  if [[ "$service" = user:* ]]; then
    unit="${service#user:}"
    if ! systemctl --user cat "$unit" >/dev/null 2>&1; then
      printf 'skipping unavailable user service: %s\n' "$unit"
    elif ! systemctl --user is-enabled --quiet "$unit"; then
      missing_services+=("$service")
    elif ! contains "$service" "${tracked_services[@]}"; then
      adopted_services+=("$service")
    fi
  elif ! systemctl cat "$service" >/dev/null 2>&1; then
    printf 'skipping unavailable service: %s\n' "$service"
  elif ! systemctl is-enabled --quiet "$service"; then
    missing_services+=("$service")
  elif ! contains "$service" "${tracked_services[@]}"; then
    adopted_services+=("$service")
  fi
done
extra_services=()
for service in "${tracked_services[@]}"; do
  contains "$service" "${declared_services[@]}" || extra_services+=("$service")
done
service_changes=()
for service in "${adopted_services[@]}"; do service_changes+=("adopt: $service"); done
for service in "${missing_services[@]}"; do service_changes+=("enable: $service"); done
for service in "${extra_services[@]}"; do service_changes+=("disable: $service"); done
if [ "${#service_changes[@]}" -gt 0 ] && confirm_stage services "${service_changes[@]}"; then
  for service in "${missing_services[@]}"; do
    if [[ "$service" = user:* ]]; then
      run systemctl --user enable --now "${service#user:}"
    else
      run systemctl enable --now "$service"
    fi
  done
  for service in "${extra_services[@]}"; do
    if [[ "$service" = user:* ]] && systemctl --user cat "${service#user:}" >/dev/null 2>&1; then
      run systemctl --user disable --now "${service#user:}"
    elif [[ "$service" != user:* ]] && systemctl cat "$service" >/dev/null 2>&1; then
      run systemctl disable --now "$service"
    fi
  done
  next_services=()
  for service in "${tracked_services[@]}"; do
    contains "$service" "${extra_services[@]}" || next_services+=("$service")
  done
  next_services+=("${adopted_services[@]}")
  next_services+=("${missing_services[@]}")
  write_state services "${next_services[@]}"
elif [ "${#service_changes[@]}" -eq 0 ]; then
  print_in_sync services
fi

sort_state_packages
sort_manifest_packages
