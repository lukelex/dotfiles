#!/usr/bin/bash

set -Eeuo pipefail

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: ./linux/install/sync [options]

Reconcile the selected profile with the initialized dotpkg manifest. The
standalone binary handles packages, groups, config links, and services.

Options:
  --desktop       Reconcile the desktop profile (default).
  --server        Reconcile the headless server profile.
  --host NAME     Apply the committed linux/hosts/NAME.yaml overlay.
  --packages-only Reconcile packages only.
  --dry-run       Print proposed changes without changing the system.
  --replace       Replace existing config paths when creating symlinks.
  --restart-services  Restart services backed by config links.
  --help          Show this help message.
EOF
}

for arg in "$@"; do
  case $arg in
    --help|-h) usage; exit 0 ;;
  esac
done

source "$install_dir/common.sh" "$@"
"$install_dir/preflight" "$@"
"$install_dir/bootstrap-yay" "$@"

dotpkg_bin="${DOTPKG_BIN:-}"
if [ -z "$dotpkg_bin" ]; then
  dotpkg_bin="$($install_dir/dotpkg --path)"
fi
if [ ! -x "$dotpkg_bin" ]; then
  printf 'dotpkg: executable not found: %s\n' "$dotpkg_bin" >&2
  exit 2
fi

dotpkg_args=(sync --profile "$INSTALL_PROFILE")
[ -z "$INSTALL_HOST" ] || dotpkg_args+=(--host "$DOTFILES/linux/hosts/$INSTALL_HOST.yaml")
[ "$DRY_RUN" -eq 0 ] || dotpkg_args+=(--dry-run)
[ "${DOTPKG_YES:-0}" = 1 ] && dotpkg_args+=(--yes)

replace=0
restart_services=0
for arg in "$@"; do
  [ "$arg" = --replace ] && replace=1
  [ "$arg" = --restart-services ] && restart_services=1
done

if [ "$PACKAGES_ONLY" -eq 0 ]; then
  dotpkg_args+=(--resources --root "$DOTFILES")
  [ "$replace" -eq 1 ] && dotpkg_args+=(--replace)
  [ "$restart_services" -eq 1 ] && dotpkg_args+=(--restart-services)
fi

"$dotpkg_bin" "${dotpkg_args[@]}"

if ! is_server && [ "$PACKAGES_ONLY" -eq 0 ]; then
  "$install_dir/binaries" "$@"
fi
