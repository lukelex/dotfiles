#!/usr/bin/bash

set -Eeuo pipefail

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dotfiles_root="$(cd "$install_dir/../.." && pwd)"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/install/state.yaml"
dotpkg_bin="${DOTPKG_BIN:-}"
if [ -z "$dotpkg_bin" ]; then
  dotpkg_bin="$($install_dir/dotpkg --path)"
fi
if [ ! -x "$dotpkg_bin" ]; then
  printf 'dotpkg: executable not found: %s\n' "$dotpkg_bin" >&2
  exit 2
fi

command=${1:-}
case $command in
  add|sync|validate|diff|clean|doctor|recover)
    shift
    ;;
  --help|-h|"")
    exec "$dotpkg_bin" --help
    ;;
  *)
    printf 'Unknown package command: %s\n' "$command" >&2
    exec "$dotpkg_bin" --help
    ;;
esac

dotpkg_args=("$command"
  --manifest "$dotfiles_root/linux/packages.yaml"
  --state-file "$state_file"
)
[ "$command" = add ] && dotpkg_args+=(--resources --root "$dotfiles_root")
[ "${DOTPKG_YES:-0}" = 1 ] && dotpkg_args+=(--yes)
dotpkg_args+=("$@")

exec "$dotpkg_bin" "${dotpkg_args[@]}"
