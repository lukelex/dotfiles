#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
source "$HOME/dotfiles/linux/variables.env"

wm_selection="$HOME/.config/dotfiles/wm-selection"
wm_profile=""
[ -f "$wm_selection" ] && wm_profile="$(tr '\n' ' ' < "$wm_selection")"

has_wm() { case " $wm_profile " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

service_categories=('.common.packages.core' ".profiles.$INSTALL_PROFILE.packages.core")
if ! is_server; then
  service_categories+=('.profiles.desktop.packages.extras')
  has_wm hyprland && service_categories+=('.profiles.desktop.packages.hyprland')
  has_wm i3 && service_categories+=('.profiles.desktop.packages.i3')
fi

mapfile -t system_services < <(manifest_package_services system "${service_categories[@]}" | sort -u)
mapfile -t user_services < <(manifest_package_services user "${service_categories[@]}" | sort -u)
[ "${#system_services[@]}" -gt 0 ] && run systemctl enable --now "${system_services[@]}"
[ "${#user_services[@]}" -gt 0 ] && run systemctl enable --user --now "${user_services[@]}"

if is_server; then
  exit 0
fi

if has_wm i3; then
  answer="$(ask 'Enable SDDM as display manager? [Y/n] ')"
  case $answer in
    [Yy]* | "")
      run systemctl enable --now sddm
      ;;
    * ) ;;
  esac

fi

if has_wm i3 || has_wm hyprland; then
  if [ -e /usr/share/dbus-1/services/org.xfce.xfce4-notifyd.Notifications.service ] \
    && [ ! -e /usr/share/dbus-1/services/org.xfce.xfce4-notifyd.Notifications.service.disabled ]; then
    run sudo mv /usr/share/dbus-1/services/org.xfce.xfce4-notifyd.Notifications.service{,.disabled}
  fi
  # Remove legacy default.target startup; the active WM imports a ready environment first.
  run systemctl --user disable quickshell.service
  run systemctl --user link "$DOTFILES/linux/config/quickshell/quickshell.service"
  run systemctl --user daemon-reload
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || { [[ -n "${DISPLAY:-}" ]] && i3 --get-socketpath >/dev/null 2>&1; }; then
    run "$DOTFILES/linux/config/quickshell/scripts/quickshell" --session-start
  fi
fi
