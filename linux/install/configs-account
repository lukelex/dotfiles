#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

if is_server; then
  install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  exec "$install_dir/configs-account-server" "$@"
fi

# Desktop packages need access to video devices, Docker, and printers.
run sudo usermod -aG video "$USER"
run sudo usermod -aG docker "$USER"
run sudo usermod -aG lp "$USER"

answer="$(ask "Set your login shell to zsh? [Y/n] ")"
case $answer in
  [Yy]* | "")
    run chsh -s /usr/bin/zsh
    ;;
  * ) ;;
esac
