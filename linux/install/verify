#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh" "$@"

failures=0
session=0
for arg in "$@"; do
  case "$arg" in
    --session) session=1 ;;
    --help|-h) printf 'Usage: linux/install/verify [--desktop|--server] [--session]\nStatic installation checks by default; --session also checks the running desktop.\n'; exit 0 ;;
  esac
done
state_file="${XDG_CONFIG_HOME:-$HOME/.config}/dotpkg/state.yaml"

check() {
  local description="$1"
  shift
  if "$@" > /dev/null 2>&1; then
    printf '  ok   %s\n' "$description"
  else
    printf '  FAIL %s\n' "$description" >&2
    failures=$((failures + 1))
  fi
}

has_selection() {
  [ -f "$state_file" ] && [ "$("$YQ" -r ".current.selections.$1" "$state_file")" = true ]
}

helper_matches() {
  [ -L "$1" ] && [ "$(readlink -f "$1")" = "$(readlink -f "$2")" ]
}

printf 'Post-install verification\n'
check "dotpkg is available" command -v dotpkg

if ! is_server; then
  for unit in dotfiles-idle dotfiles-lock; do
    check "$unit user service is linked" helper_matches "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$unit.service" "$DOTFILES/linux/config/session/$unit.service"
  done
  check "Quickshell is available" command -v quickshell
  check "Quickshell user service is linked" test -e "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/quickshell.service"

  if has_selection github-cli; then
    check "GitHub CLI is available" command -v gh
    check "GitHub review notification timer is linked" test -e "$HOME/.config/systemd/user/github-review-notify.timer"
  fi

  for script in "$DOTFILES"/linux/scripts/*; do
    [ -f "$script" ] && [ -x "$script" ] || continue
    link="/usr/local/bin/u_$(basename "$script")"
    check "helper $link points to $script" helper_matches "$link" "$script"
  done

  if has_selection hyprland; then
    for command in hyprland kanshi wl-paste xwaylandvideobridge satty; do
      check "Hyprland dependency $command is available" command -v "$command"
    done
  fi

  if has_selection i3; then
    for command in i3 picom play; do
      check "i3 dependency $command is available" command -v "$command"
    done
  fi
fi

if [ "$session" -eq 1 ] && ! is_server; then
  check "desktop session is running" test -n "${WAYLAND_DISPLAY:-${DISPLAY:-}}"
  check "user service manager is reachable" systemctl --user show-environment
  check "idle/sleep-lock owner is running" systemctl --user is-active dotfiles-idle.service
  check "idle owner belongs to a live graphical session" python3 "$DOTFILES/linux/config/system-settings/session-idle.py" check
  check "Quickshell is running" systemctl --user is-active quickshell.service
fi

if [ "$failures" -gt 0 ]; then
  printf 'verify: %d check(s) failed; rerun sync or inspect the reported dependency\n' "$failures" >&2
  exit 1
fi
