#!/usr/bin/bash
set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh" "$@"
source "$INSTALL_DIR/managed-paths.sh" "$@"

[ "$PACKAGES_ONLY" -eq 0 ] || exit 0
source_file="$DOTFILES/linux/system/network/10-dotfiles-wifi.network"
target="/etc/systemd/network/10-dotfiles-wifi.network"
if [ ! -L "$target" ] && cmp -s "$source_file" "$target"; then exit 0; fi

install_copy "$source_file" "$target"
[ "$path_conflicts" -eq 0 ] || exit 1
if systemctl is-active --quiet systemd-networkd; then
  run sudo networkctl reload
fi
