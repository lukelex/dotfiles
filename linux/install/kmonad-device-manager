#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh" "$@"

if is_server || [ "$PACKAGES_ONLY" -eq 1 ]; then
  exit 0
fi

# dotpkg owns the release files, group membership, config links and service.
# Prepare device permissions before its resource stage starts the service.
config_dir="$DOTFILES/linux/config/kmonad-device-manager"
for group in input uinput; do
  if ! getent group "$group" >/dev/null; then
    run sudo groupadd --system "$group"
  fi
done
run sudo install -Dm644 "$config_dir/70-kmonad-uinput.rules" /etc/udev/rules.d/70-kmonad-uinput.rules
run sudo install -Dm644 "$config_dir/uinput.conf" /etc/modules-load.d/uinput.conf
run sudo modprobe uinput
run sudo udevadm control --reload-rules
run sudo udevadm trigger --action=add --subsystem-match=misc --sysname-match=uinput
run sudo udevadm settle
