#!/usr/bin/bash

set -Eeuo pipefail

install_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dotfiles="$(cd "$install_dir/../.." && pwd)"
source "$install_dir/common.sh"

failures=0

check() {
  local desc="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    printf '  ok   %s\n' "$desc"
  else
    printf '  FAIL %s\n' "$desc" >&2
    failures=$((failures + 1))
  fi
}

printf 'Preflight\n'
check "not running as root" test "$(id -u)" -ne 0
check "sudo is available" command -v sudo
check "running on Arch Linux (pacman found)" command -v pacman
check "pacman sync databases are initialized (run sudo pacman -Sy if needed)" pacman -Si pacman
check "curl is available to download dotpkg" command -v curl
check "sha256sum is available to verify dotpkg" command -v sha256sum
check "GitHub is reachable to download dotpkg" curl --fail --silent --show-error --head --connect-timeout 5 --max-time 15 https://github.com
check "the AUR is reachable to bootstrap and resolve packages" curl --fail --silent --show-error --head --connect-timeout 5 --max-time 15 https://aur.archlinux.org
check "repo root matches installer" test "$dotfiles" = "$DOTFILES"
check "repo is installed at \$HOME/dotfiles" test "$dotfiles" = "$HOME/dotfiles"
if ! is_server; then
  check "fonts submodule checked out" test -d "$dotfiles/fonts/fa6/svgs"
  check "lucide svgs vendored" test -f "$dotfiles/linux/config/lucide/svg/monitor.svg"
fi

if [ "$failures" -gt 0 ]; then
  echo "preflight: $failures check(s) failed; fix these before installing" >&2
  exit 1
fi
