#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh" "$@"
source "$INSTALL_DIR/managed-paths.sh" "$@"

for script in "$DOTFILES"/linux/scripts/*; do
  [ -f "$script" ] && [ -x "$script" ] || continue
  install_link "$script" "/usr/local/bin/u_$(basename "$script")"
done

# Only an exact, installer-shaped link into this checkout proves ownership.
shopt -s nullglob
for link in /usr/local/bin/u_*; do
  [ -L "$link" ] || continue
  expected="$DOTFILES/linux/scripts/${link##*/u_}"
  [ "$(readlink "$link")" = "$expected" ] || continue
  if [ ! -f "$expected" ] || [ ! -x "$expected" ]; then
    run sudo rm -- "$link"
  fi
done
[ "$path_conflicts" -eq 0 ]
