#!/usr/bin/bash

set -Eeuo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"
source "$DOTFILES/linux/variables.env"

files=$(find "$DOTFILES/linux/scripts/" -maxdepth 1 -type f -perm 755)

for script in $files; do
  run sudo ln -fvs "$script" "/usr/local/bin/u_$(basename "$script")"
done

# Drop stale u_ links whose scripts left linux/scripts.
shopt -s nullglob
for link in /usr/local/bin/u_*; do
  [ -e "$link" ] || run sudo rm -f "$link"
done
